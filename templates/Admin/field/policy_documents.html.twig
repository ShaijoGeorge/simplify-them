{# templates/Admin/field/policy_documents.html.twig #}
{# Custom field template to render the documents collection on Policy/Claim detail pages #}

{% set documents = field.value %}

{% if documents is empty %}
    <span class="text-muted"><em>No documents uploaded yet.</em></span>
{% else %}
    <table class="table table-sm table-bordered mb-0">
        <thead class="table-light">
            <tr>
                <th>Type</th>
                <th>File Name</th>
                <th>Uploaded By</th>
                <th>Uploaded At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for doc in documents %}
                <tr>
                    <td>
                        {% set typeClass = {
                            'POLICY_BOND':       'dt-doc-badge--bond',
                            'REVIVAL_LETTER':    'dt-doc-badge--letter',
                            'ASSIGNMENT_DEED':   'dt-doc-badge--warning',
                            'DISCHARGE_VOUCHER': 'dt-doc-badge--success',
                            'CLAIM_FORM':        'dt-doc-badge--danger',
                            'OTHER':             'dt-doc-badge--other'
                        } %}
                        {% set cls = typeClass[doc.documentType] ?? 'dt-doc-badge--other' %}
                        <span class="badge dt-doc-badge {{ cls }}">
                            {{ doc.documentTypeLabel }}
                        </span>
                    </td>
                    <td>{{ doc.fileName ?? '—' }}</td>
                    <td>{{ doc.uploadedBy ?? '—' }}</td>
                    <td>{{ doc.uploadedAt ? doc.uploadedAt|date('d-M-Y H:i') : '—' }}</td>
                    <td>
                        {% if doc.filePath %}
                            <a href="{{ path('admin_policy_document_download', { id: doc.id }) }}"
                               target="_blank"
                               class="btn btn-sm btn-outline-success"
                               title="View / Download">
                                <i class="fa fa-download"></i> View
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
