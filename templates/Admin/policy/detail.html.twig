{# templates/Admin/policy/detail.html.twig #}
{# Extends EasyAdmin's default detail page and injects a Nominees panel below #}
{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block main %}
    {# ── Render the standard EasyAdmin detail fields ── #}
    {{ parent() }}

    {# ══════════════════════════════════════════════════════════
       MATURITY PROJECTION BANNER
       Shown when bonus rate data exists for this policy's plan.
       Gives agents a quick estimated maturity value.
       ══════════════════════════════════════════════════════════ #}
    {% set policy = entity.instance %}
    {% if maturity_projection is defined and maturity_projection is not null %}
        {% set proj = maturity_projection %}
        <div class="card mt-4 border-0 shadow-sm" id="maturity-projection-banner"
             style="border-left: 5px solid #10b981 !important; background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 60%, #a7f3d0 100%);">
            <div class="card-body p-4">

                {# Top row: icon + title + explanation #}
                <div class="d-flex align-items-start gap-3 mb-4">
                    <div style="width:52px;height:52px;min-width:52px;border-radius:16px;
                                background:linear-gradient(135deg,#10b981,#059669);
                                display:flex;align-items:center;justify-content:center;
                                color:#fff;font-size:22px;box-shadow:0 6px 18px rgba(16,185,129,.4);">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h5 class="mb-0 fw-bold" style="color:#064e3b;">Projected Maturity Amount (Estimated)</h5>
                            <span class="badge" style="background:#10b981;color:#fff;border-radius:8px;font-size:11px;padding:3px 10px;font-weight:700;">
                                PROJECTION
                            </span>
                        </div>
                        <p class="mb-0" style="color:#065f46;font-size:13.5px;line-height:1.5;">
                            Estimated maturity value based on currently declared LIC bonus rates for
                            <strong>{{ policy.licPlan }}</strong>.
                        </p>
                    </div>
                </div>

                {# Key figures row #}
                <div class="row g-3 mb-3">

                    {# Projected Maturity - the hero figure #}
                    <div class="col-md-3">
                        <div class="p-3 text-center h-100"
                             style="background:#fff;border-radius:14px;border:2px solid #10b981;box-shadow:0 4px 16px rgba(16,185,129,.18);">
                            <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#047857;margin-bottom:6px;">
                                <i class="fas fa-indian-rupee-sign me-1"></i> Projected Maturity
                            </div>
                            <div style="font-size:1.9rem;font-weight:800;color:#064e3b;line-height:1.1;">
                                ₹{{ proj.maturityAmount|number_format(0, '.', ',') }}
                            </div>
                            <div style="font-size:11px;color:#047857;margin-top:4px;">
                                SA + Bonus + FAB
                            </div>
                        </div>
                    </div>

                    {# Sum Assured #}
                    <div class="col-md-3">
                        <div class="p-3 text-center h-100"
                             style="background:rgba(255,255,255,.7);border-radius:14px;border:1.5px solid #6ee7b7;">
                            <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#047857;margin-bottom:6px;">
                                <i class="fas fa-file-contract me-1"></i> Sum Assured
                            </div>
                            <div style="font-size:1.5rem;font-weight:700;color:#065f46;">
                                ₹{{ proj.sumAssured|number_format(0, '.', ',') }}
                            </div>
                            <div style="font-size:11px;color:#047857;margin-top:4px;">
                                Base guarantee
                            </div>
                        </div>
                    </div>

                    {# Accrued SRB #}
                    <div class="col-md-3">
                        <div class="p-3 text-center h-100"
                             style="background:rgba(255,255,255,.7);border-radius:14px;border:1.5px solid #6ee7b7;">
                            <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#047857;margin-bottom:6px;">
                                <i class="fas fa-plus-circle me-1"></i> Accrued Bonus (SRB)
                            </div>
                            <div style="font-size:1.5rem;font-weight:700;color:#065f46;">
                                ₹{{ proj.accruedBonus|number_format(0, '.', ',') }}
                            </div>
                            <div style="font-size:11px;color:#047857;margin-top:4px;">
                                Over {{ proj.totalPolicyYears }} years
                            </div>
                        </div>
                    </div>

                    {# FAB #}
                    <div class="col-md-3">
                        <div class="p-3 text-center h-100"
                             style="background:rgba(255,255,255,.7);border-radius:14px;border:1.5px solid #6ee7b7;">
                            <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#047857;margin-bottom:6px;">
                                <i class="fas fa-award me-1"></i> Final Additional Bonus
                            </div>
                            <div style="font-size:1.5rem;font-weight:700;color:#065f46;">
                                {% if proj.fabAmount > 0 %}
                                    ₹{{ proj.fabAmount|number_format(0, '.', ',') }}
                                {% else %}
                                    <span style="font-size:1rem;color:#6b7280;">N/A</span>
                                {% endif %}
                            </div>
                            <div style="font-size:11px;color:#047857;margin-top:4px;">
                                {% if proj.fabAmount > 0 %}
                                    Term ≥ 15 years
                                {% else %}
                                    Not applicable
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                {# Rate reliability info #}
                <div class="px-2 mb-2" style="font-size:12px;color:#065f46;">
                    <i class="fas fa-info-circle me-1"></i>
                    <strong>{{ proj.yearsWithActualRate }}</strong> of {{ proj.totalPolicyYears }} years used actual declared rates
                    {% if proj.yearsWithEstimatedRate > 0 %}
                        &middot; <strong>{{ proj.yearsWithEstimatedRate }}</strong> years estimated at ₹{{ proj.latestRateUsed|number_format(2) }}/₹1000 SA (latest rate)
                    {% endif %}
                </div>

                {# Disclaimer #}
                <div class="px-3 py-2 mt-2"
                     style="background:rgba(16,185,129,.1);border-radius:10px;border:1px dashed #6ee7b7;">
                    <small style="color:#065f46;">
                        <i class="fas fa-exclamation-triangle me-1" style="color:#f59e0b;"></i>
                        <strong>Disclaimer:</strong> This is an estimate based on currently declared bonus rates and may change.
                        Actual maturity value will be determined by LIC at the time of maturity based on their valuation.
                        This projection should not be treated as a guarantee.
                    </small>
                </div>
            </div>
        </div>
    {% endif %}
    {% if policy.status == 'PAID_UP' %}
        {% set paidUpSA = policy.paidUpSumAssured %}
        {% set originalSA = policy.sumAssured %}
        {% set ppt = policy.premiumPayingTerm %}
        {% set doc = policy.commencementDate %}
        {% set yearsElapsed = doc ? (date() | date('Y') - doc | date('Y')) : 0 %}
        {% set yearsElapsed = yearsElapsed > ppt ? ppt : yearsElapsed %}

        <div class="card mt-4 border-0 shadow-sm" id="paidup-banner"
             style="border-left: 5px solid #f59e0b !important; background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 60%, #fde68a 100%);">
            <div class="card-body p-4">

                {# Top row: icon + title + explanation #}
                <div class="d-flex align-items-start gap-3 mb-4">
                    <div style="width:52px;height:52px;min-width:52px;border-radius:16px;
                                background:linear-gradient(135deg,#f59e0b,#d97706);
                                display:flex;align-items:center;justify-content:center;
                                color:#fff;font-size:22px;box-shadow:0 6px 18px rgba(245,158,11,.4);">
                        <i class="fas fa-shield-halved"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h5 class="mb-0 fw-bold" style="color:#92400e;">This Policy is PAID-UP</h5>
                            <span class="badge" style="background:#f59e0b;color:#fff;border-radius:8px;font-size:11px;padding:3px 10px;font-weight:700;">
                                PAID-UP
                            </span>
                        </div>
                        <p class="mb-0" style="color:#78350f;font-size:13.5px;line-height:1.5;">
                            Premium payments have ceased. The policy continues in force with a proportionally reduced Sum Assured.
                            The benefit below is what the client or nominee will receive on claim or maturity.
                        </p>
                    </div>
                </div>

                {# ── Key figures row ── #}
                <div class="row g-3">

                    {# Paid-Up SA - the hero figure #}
                    <div class="col-md-4">
                        <div class="p-3 text-center h-100"
                             style="background:#fff;border-radius:14px;border:2px solid #f59e0b;box-shadow:0 4px 16px rgba(245,158,11,.18);">
                            <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#b45309;margin-bottom:6px;">
                                <i class="fas fa-indian-rupee-sign me-1"></i> Paid-Up Sum Assured
                            </div>
                            {% if paidUpSA %}
                                <div style="font-size:1.9rem;font-weight:800;color:#92400e;line-height:1.1;">
                                    ₹{{ paidUpSA | number_format(0, '.', ',') }}
                                </div>
                                <div style="font-size:11px;color:#b45309;margin-top:4px;">
                                    Benefit payable to client / nominee
                                </div>
                            {% else %}
                                <div style="font-size:1.1rem;font-weight:600;color:#d97706;">
                                    <i class="fas fa-calculator me-1"></i> Not yet calculated
                                </div>
                                <div style="font-size:11px;color:#b45309;margin-top:4px;">
                                    Re-save the policy to trigger calculation
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {# Original SA #}
                    <div class="col-md-4">
                        <div class="p-3 text-center h-100"
                             style="background:rgba(255,255,255,.7);border-radius:14px;border:1.5px solid #fcd34d;">
                            <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#b45309;margin-bottom:6px;">
                                <i class="fas fa-file-contract me-1"></i> Original Sum Assured
                            </div>
                            <div style="font-size:1.5rem;font-weight:700;color:#78350f;">
                                ₹{{ originalSA | number_format(0, '.', ',') }}
                            </div>
                            <div style="font-size:11px;color:#b45309;margin-top:4px;">
                                Full benefit if all {{ ppt }} yrs premiums were paid
                            </div>
                        </div>
                    </div>

                    {# Formula breakdown #}
                    <div class="col-md-4">
                        <div class="p-3 text-center h-100"
                             style="background:rgba(255,255,255,.7);border-radius:14px;border:1.5px solid #fcd34d;">
                            <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#b45309;margin-bottom:6px;">
                                <i class="fas fa-percent me-1"></i> Calculation Basis
                            </div>
                            <div style="font-size:13px;font-weight:600;color:#92400e;line-height:1.6;">
                                {% if paidUpSA and originalSA %}
                                    {% set ratio = (paidUpSA / originalSA * 100) | round(1) %}
                                    <span style="font-size:1.5rem;font-weight:800;">{{ ratio }}%</span><br>
                                    <span style="font-size:11px;color:#b45309;">of original SA retained</span>
                                {% else %}
                                    -
                                {% endif %}
                            </div>
                            <div style="font-size:11px;color:#b45309;margin-top:6px;font-family:monospace;background:rgba(245,158,11,.1);border-radius:6px;padding:4px 8px;">
                                ({{ yearsElapsed }} yrs paid ÷ {{ ppt }} PPT) × SA
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ══════════════════════════════════════════════════════════
       DAB DEATH-CLAIM ALERT BANNER
       Shown only when status = DEATH_CLAIM AND an active DAB rider exists.
       Alerts the agent that additional (doubled) sum assured is claimable.
       ══════════════════════════════════════════════════════════ #}
    {% if policy.status == 'DEATH_CLAIM' and policy.hasActiveDabRider %}
        <div class="card mt-4 border-0 shadow-sm"
             style="border-left: 5px solid #ef4444 !important;
                    background: linear-gradient(135deg, #fff5f5 0%, #fee2e2 60%, #fecaca 100%);">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <div style="width:52px;height:52px;min-width:52px;border-radius:16px;
                                background:linear-gradient(135deg,#ef4444,#dc2626);
                                display:flex;align-items:center;justify-content:center;
                                color:#fff;font-size:22px;
                                box-shadow:0 6px 18px rgba(239,68,68,.4);">
                        <i class="fas fa-triangle-exclamation"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h5 class="mb-0 fw-bold" style="color:#7f1d1d;">
                                DAB Rider - Additional Benefit Claimable
                            </h5>
                            <span class="badge"
                                  style="background:#ef4444;color:#fff;border-radius:8px;
                                         font-size:11px;padding:3px 10px;font-weight:700;">
                                ACTION REQUIRED
                            </span>
                        </div>
                        <p class="mb-3" style="color:#991b1b;font-size:13.5px;line-height:1.6;">
                            This policy has an active <strong>Double Accident Benefit (DAB) rider</strong>.
                            If the cause of death was accidental, the nominee is entitled to
                            <strong>an additional sum assured</strong> on top of the base policy benefit.
                            Ensure the death certificate clearly states the cause before filing the claim.
                        </p>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="p-3 text-center"
                                     style="background:#fff;border-radius:12px;
                                            border:2px solid #ef4444;
                                            box-shadow:0 4px 14px rgba(239,68,68,.15);">
                                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;
                                                letter-spacing:.6px;color:#b91c1c;margin-bottom:5px;">
                                        Base Sum Assured
                                    </div>
                                    <div style="font-size:1.5rem;font-weight:800;color:#7f1d1d;">
                                        ₹{{ policy.sumAssured|number_format(0, '.', ',') }}
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 text-center"
                                     style="background:#fff;border-radius:12px;
                                            border:2px solid #f97316;
                                            box-shadow:0 4px 14px rgba(249,115,22,.15);">
                                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;
                                                letter-spacing:.6px;color:#c2410c;margin-bottom:5px;">
                                        DAB Additional Benefit
                                    </div>
                                    <div style="font-size:1.5rem;font-weight:800;color:#7c2d12;">
                                        ₹{{ policy.dabClaimableAmount|number_format(0, '.', ',') }}
                                    </div>
                                    <div style="font-size:11px;color:#c2410c;margin-top:3px;">
                                        (if death was accidental)
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 text-center"
                                     style="background:linear-gradient(135deg,#7f1d1d,#991b1b);
                                            border-radius:12px;
                                            box-shadow:0 4px 14px rgba(127,29,29,.3);">
                                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;
                                                letter-spacing:.6px;color:rgba(255,255,255,.8);margin-bottom:5px;">
                                        Total Claimable (Accidental)
                                    </div>
                                    <div style="font-size:1.7rem;font-weight:800;color:#fff;">
                                        ₹{{ (policy.sumAssured|number_format(0,'.','')|replace({',':''}) + policy.dabClaimableAmount)|number_format(0, '.', ',') }}
                                    </div>
                                    <div style="font-size:11px;color:rgba(255,255,255,.7);margin-top:3px;">
                                        Base SA + DAB rider
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ══════════════════════════════════════════════════════════
       POLICY RIDERS PANEL
       ══════════════════════════════════════════════════════════ #}
    {% set riders = policy.riders %}

    <div class="card mt-4 border-0 shadow-sm" id="riders-panel">
        <div class="card-header d-flex align-items-center justify-content-between py-3"
             style="background: linear-gradient(135deg,#fff7ed,#ffedd5);
                    border-bottom: 1.5px solid #fed7aa;">
            <div class="d-flex align-items-center gap-2">
                <span style="width:36px;height:36px;border-radius:10px;
                             background:linear-gradient(135deg,#f97316,#ea580c);
                             display:flex;align-items:center;justify-content:center;
                             color:#fff;font-size:15px;">
                    <i class="fas fa-shield-halved"></i>
                </span>
                <div>
                    <h6 class="mb-0 fw-bold" style="color:#7c2d12;">Policy Riders</h6>
                    <small class="text-muted">Add-on benefits attached to this policy</small>
                </div>
            </div>

            {# "Add Rider" button - links to the Rider NEW page pre-filled with policyId #}
            <a href="{{ ea_url()
                .unset('entityId')
                .setController('App\\Controller\\Admin\\PolicyRiderCrudController')
                .setAction('new')
                .set('policyId', policy.id) }}"
               class="btn btn-sm btn-warning"
               style="border-radius:10px;font-weight:600;
                      background:linear-gradient(135deg,#f97316,#ea580c);
                      border:none;color:#fff;
                      box-shadow:0 4px 12px rgba(249,115,22,.35);">
                <i class="fas fa-plus me-1"></i> Add Rider
            </a>
        </div>

        <div class="card-body p-0">
            {% if riders|length == 0 %}
                {# Empty state #}
                <div class="text-center py-5">
                    <div style="width:64px;height:64px;border-radius:50%;background:#fff7ed;
                                display:flex;align-items:center;justify-content:center;
                                margin:0 auto 16px;font-size:26px;color:#fdba74;">
                        <i class="fas fa-shield-halved"></i>
                    </div>
                    <p class="text-muted mb-1" style="font-weight:600;">No riders added yet</p>
                    <small class="text-muted">
                        Add riders like DAB, PWBP or Critical Illness to track additional benefits.
                    </small>
                </div>
            {% else %}
                {# Total rider premium summary bar #}
                {% set totalRiderPremium = policy.totalRiderPremium %}
                <div class="px-4 pt-3 pb-2 d-flex justify-content-between align-items-center"
                     style="background:#fffbf5;border-bottom:1px solid #fed7aa;">
                    <small class="fw-semibold" style="color:#c2410c;">
                        <i class="fas fa-coins me-1"></i>
                        Total Annual Rider Premium
                    </small>
                    <span class="fw-bold" style="color:#ea580c;font-size:15px;">
                        ₹{{ totalRiderPremium|number_format(2, '.', ',') }}
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle" style="font-size:13.5px;">
                        <thead>
                            <tr style="background:#fffbf5;border-bottom:2px solid #fed7aa;">
                                <th class="ps-4 py-3"
                                    style="color:#6b7280;font-size:11px;text-transform:uppercase;
                                           letter-spacing:.5px;font-weight:700;">Rider Type</th>
                                <th class="py-3"
                                    style="color:#6b7280;font-size:11px;text-transform:uppercase;
                                           letter-spacing:.5px;font-weight:700;">Rider SA</th>
                                <th class="py-3"
                                    style="color:#6b7280;font-size:11px;text-transform:uppercase;
                                           letter-spacing:.5px;font-weight:700;">Annual Premium</th>
                                <th class="py-3"
                                    style="color:#6b7280;font-size:11px;text-transform:uppercase;
                                           letter-spacing:.5px;font-weight:700;">Start Date</th>
                                <th class="py-3"
                                    style="color:#6b7280;font-size:11px;text-transform:uppercase;
                                           letter-spacing:.5px;font-weight:700;">End Date</th>
                                <th class="py-3"
                                    style="color:#6b7280;font-size:11px;text-transform:uppercase;
                                           letter-spacing:.5px;font-weight:700;">Status</th>
                                <th class="py-3 pe-3"
                                    style="color:#6b7280;font-size:11px;text-transform:uppercase;
                                           letter-spacing:.5px;font-weight:700;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for rider in riders %}
                                {% set typeColors = {
                                    'DAB':         '#fff7ed,#c2410c,#f97316',
                                    'PWBP':        '#eff6ff,#1d4ed8,#3b82f6',
                                    'CI':          '#fff5f5,#b91c1c,#ef4444',
                                    'TERM_RIDER':  '#f0fdf4,#15803d,#22c55e'
                                } %}
                                {% set colors = typeColors[rider.riderType] ?? '#f9fafb,#374151,#6b7280' %}
                                {% set bg = colors|split(',')|first %}
                                {% set fg = colors|split(',')|last %}
                                {% set fgDark = (colors|split(','))[1] %}

                                <tr>
                                    <td class="ps-4">
                                        <span class="badge"
                                              style="background:{{ bg }};color:{{ fgDark }};
                                                     border:1.5px solid {{ fg }};border-radius:8px;
                                                     padding:4px 10px;font-size:11px;font-weight:700;">
                                            {{ rider.riderTypeLabel }}
                                        </span>
                                        {% if rider.riderType == 'DAB' and rider.activeDabRider %}
                                            <span class="badge ms-1"
                                                  style="background:#fef3c7;color:#92400e;
                                                         font-size:10px;border-radius:6px;padding:2px 7px;">
                                                ⚡ Active
                                            </span>
                                        {% endif %}
                                    </td>

                                    <td style="font-weight:600;color:#0F1B30;">
                                        {% if rider.riderSumAssured %}
                                            ₹{{ rider.riderSumAssured|number_format(0, '.', ',') }}
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>

                                    <td style="font-weight:700;color:#ea580c;">
                                        ₹{{ rider.riderPremium|number_format(2, '.', ',') }}
                                        <span class="text-muted" style="font-size:10px;font-weight:400;">/yr</span>
                                    </td>

                                    <td class="text-muted">
                                        {{ rider.riderStartDate ? rider.riderStartDate|date('d M Y') : '-' }}
                                    </td>

                                    <td class="text-muted">
                                        {% if rider.riderEndDate %}
                                            {{ rider.riderEndDate|date('d M Y') }}
                                            {% if rider.riderEndDate < date() %}
                                                <span class="badge ms-1"
                                                      style="background:#fee2e2;color:#b91c1c;
                                                             font-size:10px;border-radius:5px;">Expired</span>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted" style="font-size:12px;">Full term</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {% if rider.active %}
                                            <span class="badge"
                                                  style="background:#dcfce7;color:#166534;
                                                         border-radius:8px;padding:3px 10px;
                                                         font-size:11px;font-weight:600;">
                                                <i class="fas fa-circle" style="font-size:7px;margin-right:4px;"></i>
                                                Active
                                            </span>
                                        {% else %}
                                            <span class="badge"
                                                  style="background:#f3f4f6;color:#6b7280;
                                                         border-radius:8px;padding:3px 10px;
                                                         font-size:11px;font-weight:600;">
                                                Inactive
                                            </span>
                                        {% endif %}
                                    </td>

                                    <td class="pe-3">
                                        <div class="d-flex gap-2">
                                            <a href="{{ ea_url()
                                                .setController('App\\Controller\\Admin\\PolicyRiderCrudController')
                                                .setAction('edit')
                                                .setEntityId(rider.id) }}"
                                               class="btn btn-xs btn-outline-warning"
                                               title="Edit Rider"
                                               style="border-radius:7px;font-size:12px;padding:3px 10px;">
                                                <i class="fas fa-pencil-alt"></i>
                                            </a>
                                            <a href="{{ ea_url()
                                                .setController('App\\Controller\\Admin\\PolicyRiderCrudController')
                                                .setAction('delete')
                                                .setEntityId(rider.id) }}"
                                               class="btn btn-xs btn-outline-danger"
                                               title="Delete Rider"
                                               style="border-radius:7px;font-size:12px;padding:3px 10px;"
                                               onclick="return confirm('Are you sure you want to delete this rider?');">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>

    {# ── Nominees Section ── #}
    {% set nominees = policy.nominees %}

    <div class="card mt-4 border-0 shadow-sm" id="nominees-panel">
        <div class="card-header d-flex align-items-center justify-content-between py-3"
             style="background: linear-gradient(135deg,#F4F7FB,#EAF0F9); border-bottom: 1.5px solid #D0DDF0;">
            <div class="d-flex align-items-center gap-2">
                <span style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#003580,#002868);
                             display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px;">
                    <i class="fas fa-user-shield"></i>
                </span>
                <div>
                    <h6 class="mb-0 fw-bold" style="color:#0F1B30;">Nominees</h6>
                    <small class="text-muted">Beneficiaries registered against this policy</small>
                </div>
            </div>

            {# "Add Nominee" button - links to the Nominee NEW page pre-filled with policyId #}
            <a href="{{ ea_url()
                .unset('entityId')
                .setController('App\\Controller\\Admin\\NomineeCrudController')
                .setAction('new')
                .set('policyId', policy.id) }}"
               class="btn btn-sm btn-primary"
               style="border-radius:10px;font-weight:600;background:linear-gradient(135deg,#003580,#002868);border:none;box-shadow:0 4px 12px rgba(0,53,128,.35);">
                <i class="fas fa-plus me-1"></i> Add Nominee
            </a>
        </div>

        <div class="card-body p-0">
            {% if nominees|length == 0 %}
                {# Empty state #}
                <div class="text-center py-5">
                    <div style="width:64px;height:64px;border-radius:50%;background:#EAF0F9;
                                display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:26px;color:#A8C4E0;">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <p class="text-muted mb-1" style="font-weight:600;">No nominees added yet</p>
                    <small class="text-muted">Add at least one nominee to ensure the policy benefit reaches the right person.</small>
                </div>
            {% else %}
                {# Share-percentage progress bar #}
                {% set totalShare = policy.totalNomineeShare %}
                <div class="px-4 pt-3 pb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <small class="fw-semibold" style="color:#003580;">Total Share Allocated</small>
                        <small class="fw-bold {% if totalShare == 100 %}text-success{% elseif totalShare > 100 %}text-danger{% else %}text-warning{% endif %}">
                            {{ totalShare|number_format(2) }}%
                            {% if totalShare == 100 %}
                                <i class="fas fa-check-circle ms-1"></i>
                            {% elseif totalShare > 100 %}
                                <i class="fas fa-exclamation-circle ms-1"></i>
                            {% else %}
                                <i class="fas fa-exclamation-triangle ms-1"></i>
                            {% endif %}
                        </small>
                    </div>
                    <div class="progress" style="height:6px;border-radius:3px;background:#D0DDF0;">
                        <div class="progress-bar {% if totalShare == 100 %}bg-success{% elseif totalShare > 100 %}bg-danger{% else %}bg-warning{% endif %}"
                             role="progressbar"
                             style="width: {{ totalShare > 100 ? 100 : totalShare }}%; border-radius:3px; transition: width .4s ease;"
                             aria-valuenow="{{ totalShare }}" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                    {% if totalShare != 100 %}
                        <small class="text-muted mt-1 d-block">
                            {% if totalShare > 100 %}
                                <span class="text-danger">⚠ Shares exceed 100%. Please correct before claim processing.</span>
                            {% else %}
                                Remaining {{ (100 - totalShare)|number_format(2) }}% is unallocated.
                            {% endif %}
                        </small>
                    {% endif %}
                </div>

                {# Nominees table #}
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle" style="font-size:13.5px;">
                        <thead>
                            <tr style="background:#F4F7FB;border-bottom:2px solid #D0DDF0;">
                                <th class="ps-4 py-3" style="color:#6b7280;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;">Name</th>
                                <th class="py-3" style="color:#6b7280;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;">Relationship</th>
                                <th class="py-3" style="color:#6b7280;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;">Date of Birth</th>
                                <th class="py-3" style="color:#6b7280;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;">Guardian</th>
                                <th class="py-3" style="color:#6b7280;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;">Mobile</th>
                                <th class="py-3" style="color:#6b7280;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;">Share %</th>
                                <th class="py-3 pe-3" style="color:#6b7280;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for nominee in nominees %}
                                <tr>
                                    <td class="ps-4 fw-semibold" style="color:#0F1B30;">
                                        {{ nominee.name }}
                                        {% if nominee.isMinor %}
                                            <span class="badge ms-1" style="background:#fef3c7;color:#92400e;font-size:10px;border-radius:6px;padding:2px 7px;">Minor</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {% set relColor = {
                                            'SPOUSE': '#dbeafe,#1e40af',
                                            'SON': '#dcfce7,#166534',
                                            'DAUGHTER': '#fce7f3,#9d174d',
                                            'FATHER': '#ede9fe,#4c1d95',
                                            'MOTHER': '#fef3c7,#92400e',
                                            'BROTHER': '#e0f2fe,#075985',
                                            'SISTER': '#fae8ff,#701a75',
                                            'OTHER': '#f3f4f6,#374151'
                                        } %}
                                        {% set colors = relColor[nominee.relationship] ?? '#f3f4f6,#374151' %}
                                        {% set bg = colors|split(',')|first %}
                                        {% set fg = colors|split(',')|last %}
                                        <span class="badge" style="background:{{ bg }};color:{{ fg }};border-radius:8px;padding:3px 10px;font-size:11px;font-weight:600;">
                                            {{ nominee.relationship|capitalize }}
                                        </span>
                                    </td>

                                    <td class="text-muted">
                                        {% if nominee.dob %}
                                            {{ nominee.dob|date('d M Y') }}
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {% if nominee.guardianName %}
                                            <span style="color:#374151;">{{ nominee.guardianName }}</span>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>

                                    <td class="text-muted">
                                        {{ nominee.mobile ?: '-' }}
                                    </td>

                                    <td>
                                        <span class="fw-bold" style="color:#003580;font-size:14px;">
                                            {{ nominee.sharePercentage|number_format(2) }}%
                                        </span>
                                    </td>

                                    <td class="pe-3">
                                        <div class="d-flex gap-2">
                                            <a href="{{ ea_url()
                                                .setController('App\\Controller\\Admin\\NomineeCrudController')
                                                .setAction('edit')
                                                .setEntityId(nominee.id) }}"
                                               class="btn btn-xs btn-outline-primary"
                                               title="Edit"
                                               style="border-radius:7px;font-size:12px;padding:3px 10px;">
                                                <i class="fas fa-pencil-alt"></i>
                                            </a>
                                            <a href="{{ ea_url()
                                                .setController('App\\Controller\\Admin\\NomineeCrudController')
                                                .setAction('delete')
                                                .setEntityId(nominee.id) }}"
                                               class="btn btn-xs btn-outline-danger"
                                               title="Delete"
                                               style="border-radius:7px;font-size:12px;padding:3px 10px;"
                                               onclick="return confirm('Are you sure you want to delete this nominee?');">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
