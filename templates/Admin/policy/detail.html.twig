{# templates/Admin/policy/detail.html.twig #}
{# Extends EasyAdmin's default detail page and injects a Nominees panel below #}
{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block main %}
    {# ── Render the standard EasyAdmin detail fields ── #}
    {{ parent() }}

    {# ══════════════════════════════════════════════════════════
       MATURITY PROJECTION BANNER
       Shown when bonus rate data exists for this policy's plan.
       Gives agents a quick estimated maturity value.
       ══════════════════════════════════════════════════════════ #}
    {% set policy = entity.instance %}
    {% if maturity_projection is defined and maturity_projection is not null %}
        {% set proj = maturity_projection %}
        <div class="card dt-card dt-card--accent-left dt-projection" id="maturity-projection-banner">
            <div class="dt-card__body">

                {# Top row: icon + title + explanation #}
                <div class="d-flex align-items-start gap-3 mb-4">
                    <div class="dt-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h5 class="mb-0 dt-card__title">Projected Maturity Amount (Estimated)</h5>
                            <span class="dt-badge">PROJECTION</span>
                        </div>
                        <p class="mb-0 dt-card__desc">
                            Estimated maturity value based on currently declared LIC bonus rates for
                            <strong>{{ policy.licPlan }}</strong>.
                        </p>
                    </div>
                </div>

                {# Key figures row #}
                <div class="row g-3 mb-3">

                    {# Projected Maturity - the hero figure #}
                    <div class="col-md-3">
                        <div class="dt-metric dt-metric--hero">
                            <div class="dt-metric__label">
                                <i class="fas fa-indian-rupee-sign me-1"></i> Projected Maturity
                            </div>
                            <div class="dt-metric__value dt-metric__value--hero">
                                ₹{{ proj.maturityAmount|number_format(0, '.', ',') }}
                            </div>
                            <div class="dt-metric__sub">
                                SA + Bonus + FAB
                            </div>
                        </div>
                    </div>

                    {# Sum Assured #}
                    <div class="col-md-3">
                        <div class="dt-metric dt-metric--secondary">
                            <div class="dt-metric__label">
                                <i class="fas fa-file-contract me-1"></i> Sum Assured
                            </div>
                            <div class="dt-metric__value">
                                ₹{{ proj.sumAssured|number_format(0, '.', ',') }}
                            </div>
                            <div class="dt-metric__sub">
                                Base guarantee
                            </div>
                        </div>
                    </div>

                    {# Accrued SRB #}
                    <div class="col-md-3">
                        <div class="dt-metric dt-metric--secondary">
                            <div class="dt-metric__label">
                                <i class="fas fa-plus-circle me-1"></i> Accrued Bonus (SRB)
                            </div>
                            <div class="dt-metric__value">
                                ₹{{ proj.accruedBonus|number_format(0, '.', ',') }}
                            </div>
                            <div class="dt-metric__sub">
                                Over {{ proj.totalPolicyYears }} years
                            </div>
                        </div>
                    </div>

                    {# FAB #}
                    <div class="col-md-3">
                        <div class="dt-metric dt-metric--secondary">
                            <div class="dt-metric__label">
                                <i class="fas fa-award me-1"></i> Final Additional Bonus
                            </div>
                            <div class="dt-metric__value">
                                {% if proj.fabAmount > 0 %}
                                    ₹{{ proj.fabAmount|number_format(0, '.', ',') }}
                                {% else %}
                                    <span class="text-muted" style="font-size:1rem;">N/A</span>
                                {% endif %}
                            </div>
                            <div class="dt-metric__sub">
                                {% if proj.fabAmount > 0 %}
                                    Term ≥ 15 years
                                {% else %}
                                    Not applicable
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                {# Rate reliability info #}
                <div class="dt-info">
                    <i class="fas fa-info-circle me-1"></i>
                    <strong>{{ proj.yearsWithActualRate }}</strong> of {{ proj.totalPolicyYears }} years used actual declared rates
                    {% if proj.yearsWithEstimatedRate > 0 %}
                        &middot; <strong>{{ proj.yearsWithEstimatedRate }}</strong> years estimated at ₹{{ proj.latestRateUsed|number_format(2) }}/₹1000 SA (latest rate)
                    {% endif %}
                </div>

                {# Disclaimer #}
                <div class="dt-disclaimer">
                    <small>
                        <i class="fas fa-exclamation-triangle me-1" style="color:var(--color-warning);"></i>
                        <strong>Disclaimer:</strong> This is an estimate based on currently declared bonus rates and may change.
                        Actual maturity value will be determined by LIC at the time of maturity based on their valuation.
                        This projection should not be treated as a guarantee.
                    </small>
                </div>
            </div>
        </div>
    {% endif %}
    {% if policy.status == 'PAID_UP' %}
        {% set paidUpSA = policy.paidUpSumAssured %}
        {% set originalSA = policy.sumAssured %}
        {% set ppt = policy.premiumPayingTerm %}
        {% set doc = policy.commencementDate %}
        {% set yearsElapsed = doc ? (date() | date('Y') - doc | date('Y')) : 0 %}
        {% set yearsElapsed = yearsElapsed > ppt ? ppt : yearsElapsed %}

        <div class="card dt-card dt-card--accent-left dt-paidup" id="paidup-banner">
            <div class="dt-card__body">

                {# Top row: icon + title + explanation #}
                <div class="d-flex align-items-start gap-3 mb-4">
                    <div class="dt-icon">
                        <i class="fas fa-shield-halved"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h5 class="mb-0 dt-card__title">This Policy is PAID-UP</h5>
                            <span class="dt-badge">PAID-UP</span>
                        </div>
                        <p class="mb-0 dt-card__desc">
                            Premium payments have ceased. The policy continues in force with a proportionally reduced Sum Assured.
                            The benefit below is what the client or nominee will receive on claim or maturity.
                        </p>
                    </div>
                </div>

                {# ── Key figures row ── #}
                <div class="row g-3">

                    {# Paid-Up SA - the hero figure #}
                    <div class="col-md-4">
                        <div class="dt-metric dt-metric--hero">
                            <div class="dt-metric__label">
                                <i class="fas fa-indian-rupee-sign me-1"></i> Paid-Up Sum Assured
                            </div>
                            {% if paidUpSA %}
                                <div class="dt-metric__value dt-metric__value--hero">
                                    ₹{{ paidUpSA | number_format(0, '.', ',') }}
                                </div>
                                <div class="dt-metric__sub">
                                    Benefit payable to client / nominee
                                </div>
                            {% else %}
                                <div class="dt-metric__value" style="font-size:1.1rem;">
                                    <i class="fas fa-calculator me-1"></i> Not yet calculated
                                </div>
                                <div class="dt-metric__sub">
                                    Re-save the policy to trigger calculation
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {# Original SA #}
                    <div class="col-md-4">
                        <div class="dt-metric dt-metric--secondary">
                            <div class="dt-metric__label">
                                <i class="fas fa-file-contract me-1"></i> Original Sum Assured
                            </div>
                            <div class="dt-metric__value">
                                ₹{{ originalSA | number_format(0, '.', ',') }}
                            </div>
                            <div class="dt-metric__sub">
                                Full benefit if all {{ ppt }} yrs premiums were paid
                            </div>
                        </div>
                    </div>

                    {# Formula breakdown #}
                    <div class="col-md-4">
                        <div class="dt-metric dt-metric--secondary">
                            <div class="dt-metric__label">
                                <i class="fas fa-percent me-1"></i> Calculation Basis
                            </div>
                            <div class="dt-metric__value">
                                {% if paidUpSA and originalSA %}
                                    {% set ratio = (paidUpSA / originalSA * 100) | round(1) %}
                                    <span style="font-size:1.5rem;font-weight:800;">{{ ratio }}%</span>
                                {% else %}
                                    -
                                {% endif %}
                            </div>
                            {% if paidUpSA and originalSA %}
                                <div class="dt-metric__sub">of original SA retained</div>
                            {% endif %}
                            <div class="dt-metric__formula">
                                ({{ yearsElapsed }} yrs paid ÷ {{ ppt }} PPT) × SA
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ══════════════════════════════════════════════════════════
       DAB DEATH-CLAIM ALERT BANNER
       Shown only when status = DEATH_CLAIM AND an active DAB rider exists.
       Alerts the agent that additional (doubled) sum assured is claimable.
       ══════════════════════════════════════════════════════════ #}
    {% if policy.status == 'DEATH_CLAIM' and policy.hasActiveDabRider %}
        <div class="card dt-card dt-card--accent-left dt-dab">
            <div class="dt-card__body">
                <div class="d-flex align-items-start gap-3">
                    <div class="dt-icon">
                        <i class="fas fa-triangle-exclamation"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h5 class="mb-0 dt-card__title">
                                DAB Rider - Additional Benefit Claimable
                            </h5>
                            <span class="dt-badge">ACTION REQUIRED</span>
                        </div>
                        <p class="mb-3 dt-card__desc">
                            This policy has an active <strong>Double Accident Benefit (DAB) rider</strong>.
                            If the cause of death was accidental, the nominee is entitled to
                            <strong>an additional sum assured</strong> on top of the base policy benefit.
                            Ensure the death certificate clearly states the cause before filing the claim.
                        </p>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="dt-metric dt-metric--hero">
                                    <div class="dt-metric__label">
                                        Base Sum Assured
                                    </div>
                                    <div class="dt-metric__value dt-metric__value--hero">
                                        ₹{{ policy.sumAssured|number_format(0, '.', ',') }}
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="dt-metric dt-metric--secondary">
                                    <div class="dt-metric__label">
                                        DAB Additional Benefit
                                    </div>
                                    <div class="dt-metric__value">
                                        ₹{{ policy.dabClaimableAmount|number_format(0, '.', ',') }}
                                    </div>
                                    <div class="dt-metric__sub">
                                        (if death was accidental)
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="dt-metric dt-metric--total">
                                    <div class="dt-metric__label">
                                        Total Claimable (Accidental)
                                    </div>
                                    <div class="dt-metric__value dt-metric__value--hero">
                                        ₹{{ (policy.sumAssured|number_format(0,'.','')|replace({',':''}) + policy.dabClaimableAmount)|number_format(0, '.', ',') }}
                                    </div>
                                    <div class="dt-metric__sub">
                                        Base SA + DAB rider
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ══════════════════════════════════════════════════════════
       POLICY RIDERS PANEL
       ══════════════════════════════════════════════════════════ #}
    {% set riders = policy.riders %}

    <div class="card mt-4 dt-card dt-riders" id="riders-panel">
        <div class="dt-panel__header">
            <div class="d-flex align-items-center gap-2">
                <span class="dt-icon dt-icon--sm">
                    <i class="fas fa-shield-halved"></i>
                </span>
                <div>
                    <h6 class="dt-panel__title">Policy Riders</h6>
                    <small class="dt-panel__subtitle">Add-on benefits attached to this policy</small>
                </div>
            </div>

            {# "Add Rider" button - links to the Rider NEW page pre-filled with policyId #}
            <a href="{{ ea_url()
                .unset('entityId')
                .setController('App\\Controller\\Admin\\PolicyRiderCrudController')
                .setAction('new')
                .set('policyId', policy.id) }}"
               class="dt-btn">
                <i class="fas fa-plus"></i> Add Rider
            </a>
        </div>

        <div class="card-body p-0">
            {% if riders|length == 0 %}
                {# Empty state #}
                <div class="dt-empty">
                    <div class="dt-empty__icon">
                        <i class="fas fa-shield-halved"></i>
                    </div>
                    <p class="text-muted mb-1" style="font-weight:600;">No riders added yet</p>
                    <small class="text-muted">
                        Add riders like DAB, PWBP or Critical Illness to track additional benefits.
                    </small>
                </div>
            {% else %}
                {# Total rider premium summary bar #}
                {% set totalRiderPremium = policy.totalRiderPremium %}
                <div class="dt-summary-bar">
                    <small class="dt-summary-bar__label">
                        <i class="fas fa-coins me-1"></i>
                        Total Annual Rider Premium
                    </small>
                    <span class="dt-summary-bar__value">
                        ₹{{ totalRiderPremium|number_format(2, '.', ',') }}
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle dt-table">
                        <thead>
                            <tr>
                                <th class="ps-4 py-3">Rider Type</th>
                                <th class="py-3">Rider SA</th>
                                <th class="py-3">Annual Premium</th>
                                <th class="py-3">Start Date</th>
                                <th class="py-3">End Date</th>
                                <th class="py-3">Status</th>
                                <th class="py-3 pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for rider in riders %}
                                {% set badgeClass = {
                                    'DAB':         'dt-rider-badge--dab',
                                    'PWBP':        'dt-rider-badge--pwbp',
                                    'CI':          'dt-rider-badge--ci',
                                    'TERM_RIDER':  'dt-rider-badge--term'
                                } %}
                                {% set cls = badgeClass[rider.riderType] ?? 'dt-rider-badge--default' %}

                                <tr>
                                    <td class="ps-4">
                                        <span class="badge dt-rider-badge {{ cls }}">
                                            {{ rider.riderTypeLabel }}
                                        </span>
                                        {% if rider.riderType == 'DAB' and rider.activeDabRider %}
                                            <span class="badge ms-1 dt-rider-active">
                                                ⚡ Active
                                            </span>
                                        {% endif %}
                                    </td>

                                    <td class="dt-rider-sa">
                                        {% if rider.riderSumAssured %}
                                            ₹{{ rider.riderSumAssured|number_format(0, '.', ',') }}
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>

                                    <td class="dt-rider-premium">
                                        ₹{{ rider.riderPremium|number_format(2, '.', ',') }}
                                        <span class="text-muted" style="font-size:10px;font-weight:400;">/yr</span>
                                    </td>

                                    <td class="text-muted">
                                        {{ rider.riderStartDate ? rider.riderStartDate|date('d M Y') : '-' }}
                                    </td>

                                    <td class="text-muted">
                                        {% if rider.riderEndDate %}
                                            {{ rider.riderEndDate|date('d M Y') }}
                                            {% if rider.riderEndDate < date() %}
                                                <span class="badge ms-1 dt-rider-expired">Expired</span>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted" style="font-size:12px;">Full term</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {% if rider.active %}
                                            <span class="badge dt-status--active">
                                                <i class="fas fa-circle" style="font-size:7px;margin-right:4px;"></i>
                                                Active
                                            </span>
                                        {% else %}
                                            <span class="badge dt-status--inactive">
                                                Inactive
                                            </span>
                                        {% endif %}
                                    </td>

                                    <td class="pe-3">
                                        <div class="d-flex gap-2">
                                            <a href="{{ ea_url()
                                                .setController('App\\Controller\\Admin\\PolicyRiderCrudController')
                                                .setAction('edit')
                                                .setEntityId(rider.id) }}"
                                               class="btn btn-xs btn-outline-warning dt-action-btn"
                                               title="Edit Rider">
                                                <i class="fas fa-pencil-alt"></i>
                                            </a>
                                            <button type="button"
                                               formaction="{{ ea_url()
                                                   .setController('App\\Controller\\Admin\\PolicyRiderCrudController')
                                                   .setAction('delete')
                                                   .setEntityId(rider.id) }}"
                                               class="btn btn-xs btn-outline-danger dt-action-btn"
                                               data-action-name="delete"
                                               title="Delete Rider">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>

    {# ── Nominees Section ── #}
    {% set nominees = policy.nominees %}

    <div class="card mt-4 dt-card dt-nominees" id="nominees-panel">
        <div class="dt-panel__header">
            <div class="d-flex align-items-center gap-2">
                <span class="dt-icon dt-icon--sm">
                    <i class="fas fa-user-shield"></i>
                </span>
                <div>
                    <h6 class="dt-panel__title">Nominees</h6>
                    <small class="dt-panel__subtitle">Beneficiaries registered against this policy</small>
                </div>
            </div>

            {# "Add Nominee" button - links to the Nominee NEW page pre-filled with policyId #}
            <a href="{{ ea_url()
                .unset('entityId')
                .setController('App\\Controller\\Admin\\NomineeCrudController')
                .setAction('new')
                .set('policyId', policy.id) }}"
               class="dt-btn">
                <i class="fas fa-plus"></i> Add Nominee
            </a>
        </div>

        <div class="card-body p-0">
            {% if nominees|length == 0 %}
                {# Empty state #}
                <div class="dt-empty">
                    <div class="dt-empty__icon">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <p class="text-muted mb-1" style="font-weight:600;">No nominees added yet</p>
                    <small class="text-muted">Add at least one nominee to ensure the policy benefit reaches the right person.</small>
                </div>
            {% else %}
                {# Share-percentage progress bar #}
                {% set totalShare = policy.totalNomineeShare %}
                <div class="px-4 pt-3 pb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <small class="dt-share-label">Total Share Allocated</small>
                        <small class="fw-bold {% if totalShare == 100 %}text-success{% elseif totalShare > 100 %}text-danger{% else %}text-warning{% endif %}">
                            {{ totalShare|number_format(2) }}%
                            {% if totalShare == 100 %}
                                <i class="fas fa-check-circle ms-1"></i>
                            {% elseif totalShare > 100 %}
                                <i class="fas fa-exclamation-circle ms-1"></i>
                            {% else %}
                                <i class="fas fa-exclamation-triangle ms-1"></i>
                            {% endif %}
                        </small>
                    </div>
                    <div class="progress dt-progress">
                        <div class="progress-bar {% if totalShare == 100 %}bg-success{% elseif totalShare > 100 %}bg-danger{% else %}bg-warning{% endif %}"
                             role="progressbar"
                             style="width: {{ totalShare > 100 ? 100 : totalShare }}%; border-radius:3px; transition: width .4s ease;"
                             aria-valuenow="{{ totalShare }}" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                    {% if totalShare != 100 %}
                        <small class="text-muted mt-1 d-block">
                            {% if totalShare > 100 %}
                                <span class="text-danger">⚠ Shares exceed 100%. Please correct before claim processing.</span>
                            {% else %}
                                Remaining {{ (100 - totalShare)|number_format(2) }}% is unallocated.
                            {% endif %}
                        </small>
                    {% endif %}
                </div>

                {# Nominees table #}
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle dt-table">
                        <thead>
                            <tr>
                                <th class="ps-4 py-3">Name</th>
                                <th class="py-3">Relationship</th>
                                <th class="py-3">Date of Birth</th>
                                <th class="py-3">Guardian</th>
                                <th class="py-3">Mobile</th>
                                <th class="py-3">Share %</th>
                                <th class="py-3 pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for nominee in nominees %}
                                <tr>
                                    <td class="ps-4 dt-nominee-name">
                                        {{ nominee.name }}
                                        {% if nominee.isMinor %}
                                            <span class="badge ms-1 dt-nominee-minor">Minor</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {% set relClass = {
                                            'SPOUSE':   'dt-rel-badge--spouse',
                                            'SON':      'dt-rel-badge--son',
                                            'DAUGHTER': 'dt-rel-badge--daughter',
                                            'FATHER':   'dt-rel-badge--father',
                                            'MOTHER':   'dt-rel-badge--mother',
                                            'BROTHER':  'dt-rel-badge--brother',
                                            'SISTER':   'dt-rel-badge--sister',
                                            'OTHER':    'dt-rel-badge--other'
                                        } %}
                                        {% set cls = relClass[nominee.relationship] ?? 'dt-rel-badge--other' %}
                                        <span class="badge dt-rel-badge {{ cls }}">
                                            {{ nominee.relationship|capitalize }}
                                        </span>
                                    </td>

                                    <td class="text-muted">
                                        {% if nominee.dob %}
                                            {{ nominee.dob|date('d M Y') }}
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {% if nominee.guardianName %}
                                            <span>{{ nominee.guardianName }}</span>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>

                                    <td class="text-muted">
                                        {{ nominee.mobile ?: '-' }}
                                    </td>

                                    <td>
                                        <span class="dt-share-value">
                                            {{ nominee.sharePercentage|number_format(2) }}%
                                        </span>
                                    </td>

                                    <td class="pe-3">
                                        <div class="d-flex gap-2">
                                            <a href="{{ ea_url()
                                                .setController('App\\Controller\\Admin\\NomineeCrudController')
                                                .setAction('edit')
                                                .setEntityId(nominee.id) }}"
                                               class="btn btn-xs btn-outline-primary dt-action-btn"
                                               title="Edit">
                                                <i class="fas fa-pencil-alt"></i>
                                            </a>
                                            <button type="button"
                                               formaction="{{ ea_url()
                                                   .setController('App\\Controller\\Admin\\NomineeCrudController')
                                                   .setAction('delete')
                                                   .setEntityId(nominee.id) }}"
                                               class="btn btn-xs btn-outline-danger dt-action-btn"
                                               data-action-name="delete"
                                               title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>

    {# ── Policy Documents Section ── #}
    {% set documents = policy.documents %}

    <div class="card mt-4 dt-card dt-documents" id="documents-panel">
        <div class="dt-panel__header">
            <div class="d-flex align-items-center gap-2">
                <span class="dt-icon dt-icon--sm">
                    <i class="fas fa-file-pdf"></i>
                </span>
                <div>
                    <h6 class="dt-panel__title">Policy Documents</h6>
                    <small class="dt-panel__subtitle">Bonds, letters, and other records</small>
                </div>
            </div>

            {# "Add Document" button - links to the PolicyDocument NEW page pre-filled with policyId #}
            <a href="{{ ea_url()
                .unset('entityId')
                .setController('App\\Controller\\Admin\\PolicyDocumentCrudController')
                .setAction('new')
                .set('policyId', policy.id) }}"
               class="dt-btn">
                <i class="fas fa-plus"></i> Add Document
            </a>
        </div>

        <div class="card-body p-0">
            {% if documents|length == 0 %}
                {# Empty state #}
                <div class="dt-empty">
                    <div class="dt-empty__icon">
                        <i class="fas fa-file-pdf"></i>
                    </div>
                    <p class="text-muted mb-1" style="font-weight:600;">No documents uploaded yet</p>
                    <small class="text-muted">Upload policy bonds, revival letters or claim forms for easy access.</small>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle dt-table">
                        <thead>
                            <tr>
                                <th class="ps-4 py-3">Type</th>
                                <th class="py-3">File Name</th>
                                <th class="py-3">Uploaded By</th>
                                <th class="py-3">Uploaded At</th>
                                <th class="py-3 pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for doc in documents %}
                                <tr>
                                    <td class="ps-4">
                                        {% set typeClass = {
                                            'POLICY_BOND':       'dt-doc-badge--bond',
                                            'REVIVAL_LETTER':    'dt-doc-badge--letter',
                                            'ASSIGNMENT_DEED':   'dt-doc-badge--warning',
                                            'DISCHARGE_VOUCHER': 'dt-doc-badge--success',
                                            'CLAIM_FORM':        'dt-doc-badge--danger',
                                            'OTHER':             'dt-doc-badge--other'
                                        } %}
                                        {% set cls = typeClass[doc.documentType] ?? 'dt-doc-badge--other' %}
                                        <span class="badge dt-doc-badge {{ cls }}">
                                            {{ doc.documentTypeLabel }}
                                        </span>
                                    </td>
                                    <td>{{ doc.fileName ?? '—' }}</td>
                                    <td>{{ doc.uploadedBy ?? '—' }}</td>
                                    <td class="text-muted">{{ doc.uploadedAt ? doc.uploadedAt|date('d M Y') : '—' }}</td>
                                    <td class="pe-3">
                                        <div class="d-flex gap-2">
                                            {% if doc.filePath %}
                                                <a href="{{ path('admin_policy_document_download', { id: doc.id }) }}"
                                                   target="_blank"
                                                   class="btn btn-xs btn-outline-success dt-action-btn"
                                                   title="View / Download">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            {% endif %}
                                            <a href="{{ ea_url()
                                                .setController('App\\Controller\\Admin\\PolicyDocumentCrudController')
                                                .setAction('edit')
                                                .setEntityId(doc.id) }}"
                                               class="btn btn-xs btn-outline-primary dt-action-btn"
                                               title="Edit">
                                                <i class="fas fa-pencil-alt"></i>
                                            </a>
                                            <button type="button"
                                               formaction="{{ ea_url()
                                                   .setController('App\\Controller\\Admin\\PolicyDocumentCrudController')
                                                   .setAction('delete')
                                                   .setEntityId(doc.id) }}"
                                               class="btn btn-xs btn-outline-danger dt-action-btn"
                                               data-action-name="delete"
                                               title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
