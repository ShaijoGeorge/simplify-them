{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{% endblock %}

{% block main %}
<div class="db">

    {# ── Greeting ── #}
    <header class="db-header">
        <div>
            <p class="db-greeting">{{ greeting }},</p>
            <h1 class="db-name">{{ user_name }}</h1>
        </div>
        <div class="db-date">
            <i class="fas fa-calendar-alt"></i>
            <span>{{ today_date }}</span>
        </div>
    </header>

    {# ── Metric Cards ── #}
    <div class="db-metrics">
        <div class="db-card db-card--gold">
            <div class="db-card__body">
                <div class="db-card__info">
                    <span class="db-card__label">Premiums Due</span>
                    <span class="db-card__value">₹{{ (due_amount/100)|number_format(2) }}</span>
                    <span class="db-card__sub">Expected for {{ current_month }}</span>
                </div>
                <div class="db-card__icon db-card__icon--gold">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>
        </div>

        <div class="db-card db-card--blue">
            <div class="db-card__body">
                <div class="db-card__info">
                    <span class="db-card__label">Active Policies</span>
                    <span class="db-card__value">{{ active_policies }}</span>
                    <span class="db-card__sub">In-force policies</span>
                </div>
                <div class="db-card__icon db-card__icon--blue">
                    <i class="fas fa-shield-halved"></i>
                </div>
            </div>
        </div>

        <div class="db-card db-card--teal">
            <div class="db-card__body">
                <div class="db-card__info">
                    <span class="db-card__label">Total Clients</span>
                    <span class="db-card__value">{{ total_clients }}</span>
                    <span class="db-card__sub">Registered clients</span>
                </div>
                <div class="db-card__icon db-card__icon--teal">
                    <i class="fas fa-users"></i>
                </div>
            </div>
        </div>

        <div class="db-card db-card--green">
            <div class="db-card__body">
                <div class="db-card__info">
                    <span class="db-card__label">{{ current_month }} Collection</span>
                    <span class="db-card__value">₹{{ collected_this_month|number_format(2) }}</span>
                    <span class="db-card__sub">Premiums collected</span>
                </div>
                <div class="db-card__icon db-card__icon--green">
                    <i class="fas fa-indian-rupee-sign"></i>
                </div>
            </div>
        </div>
    </div>

    {# ── Middle Row: Revival + Birthdays ── #}
    <div class="db-middle">

        {# Revival Opportunities #}
        <a href="{{ ea_url()
            .setController('App\\Controller\\Admin\\PolicyCrudController')
            .setAction('index')
            .set('filters[status][comparison]', '=')
            .set('filters[status][value]', 'LAPSED') }}"
           class="db-revival text-decoration-none">
            <div class="db-revival__head">
                <div>
                    <h6 class="db-section-label">Revival Opportunities</h6>
                    <small class="db-section-sub">Lapsed over 6 months</small>
                </div>
                {% if lapsed_count > 0 %}
                    <span class="db-pulse"></span>
                {% endif %}
            </div>
            <div class="db-revival__count">{{ lapsed_count }}</div>
            <span class="db-revival__cta">View all <i class="fas fa-arrow-right"></i></span>
        </a>

        {# Birthdays This Month #}
        <div class="db-birthdays">
            <div class="db-birthdays__head">
                <h6 class="db-section-label">Birthdays This Month 🎂</h6>
                <span class="db-badge">{{ birthdays|length }}</span>
            </div>
            {% if birthdays|length > 0 %}
                <ul class="db-birthdays__list">
                    {% for b in birthdays[:8] %}
                        <li class="db-birthdays__item">
                            <div class="db-birthdays__avatar">
                                {{ b.name|slice(0,1)|upper }}
                            </div>
                            <div class="db-birthdays__detail">
                                <span class="db-birthdays__name">{{ b.name }}</span>
                                {% if b.dob %}
                                    <span class="db-birthdays__date">{{ b.dob|date('d M') }}</span>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
                {% if birthdays|length > 8 %}
                    <div class="db-birthdays__more">+ {{ birthdays|length - 8 }} more</div>
                {% endif %}
            {% else %}
                <div class="db-empty">
                    <i class="fas fa-gift"></i>
                    <span>No birthdays this month</span>
                </div>
            {% endif %}
        </div>
    </div>

    {# ── Survival Benefits ── #}
    <div class="db-panel db-survival">
        <div class="db-panel__head">
            <div class="db-panel__icon db-panel__icon--amber">
                <i class="fas fa-hand-holding-dollar"></i>
            </div>
            <div>
                <h6 class="db-section-label">Survival Benefits Due</h6>
                <small class="db-section-sub">Pending payouts this month &amp; overdue</small>
            </div>
            <span class="db-badge db-badge--amber ms-auto">{{ survival_benefits|length }}</span>
        </div>

        {% if survival_benefits|length > 0 %}
            <div class="table-responsive">
                <table class="db-table">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Policy No</th>
                            <th>Due Date</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for sb in survival_benefits %}
                            {% set is_overdue = sb.dueDate < date() %}
                            <tr>
                                <td class="fw-medium">{{ sb.policy.client ?? '—' }}</td>
                                <td><code>{{ sb.policy.policyNumber ?? '—' }}</code></td>
                                <td>
                                    <span class="{{ is_overdue ? 'db-overdue' : '' }}">
                                        {{ sb.dueDate|date('d-M-Y') }}
                                        {% if is_overdue %}
                                            <i class="fas fa-exclamation-circle ms-1"></i>
                                        {% endif %}
                                    </span>
                                </td>
                                <td class="text-end fw-semibold">₹{{ sb.amount|number_format(2) }}</td>
                                <td class="text-center">
                                    <a href="{{ ea_url()
                                        .setController('App\\Controller\\Admin\\SurvivalBenefitCrudController')
                                        .setAction('markCollected')
                                        .setEntityId(sb.id) }}"
                                       class="db-btn db-btn--success"
                                       title="Mark as Collected">
                                        <i class="fas fa-check me-1"></i>Collected
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="db-empty db-empty--lg">
                <i class="fas fa-check-circle"></i>
                <span>No survival benefits due this month 🎉</span>
            </div>
        {% endif %}
    </div>

    {# ── Quick Actions ── #}
    <div class="db-actions">
        <h6 class="db-section-label mb-3">Quick Actions</h6>
        <div class="db-actions__grid">
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\ClientCrudController').setAction('new') }}" class="db-action">
                <div class="db-action__icon db-action__icon--teal"><i class="fas fa-user-plus"></i></div>
                <div><strong>Add Client</strong><small>Register a customer</small></div>
            </a>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\PolicyCrudController').setAction('new') }}" class="db-action">
                <div class="db-action__icon db-action__icon--blue"><i class="fas fa-file-signature"></i></div>
                <div><strong>Create Policy</strong><small>Term, Endowment & more</small></div>
            </a>
            <a href="{{ path('app_quick_policy') }}" class="db-action">
                <div class="db-action__icon db-action__icon--gold"><i class="fas fa-bolt"></i></div>
                <div><strong>Quick Entry</strong><small>Fast policy capture</small></div>
            </a>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\PremiumReceiptCrudController').setAction('new') }}" class="db-action">
                <div class="db-action__icon db-action__icon--green"><i class="fas fa-coins"></i></div>
                <div><strong>Collect Premium</strong><small>Payment & receipt</small></div>
            </a>
        </div>
    </div>

</div>
{% endblock %}