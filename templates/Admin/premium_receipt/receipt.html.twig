<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">

    <style>
        body {
            font-family: "DejaVu Sans", sans-serif;
            font-size: 12px;
            color: #333;
            padding: 20px;
            border: 2px solid #444;
        }

        /* HEADER */
        .header {
            text-align: center;
            margin-bottom: 20px;
        }

        .agency-name {
            font-size: 18px;
            font-weight: bold;
            color: #222;
        }

        .doc-title {
            font-size: 14px;
            margin-top: 6px;
            text-transform: uppercase;
            font-weight: bold;
        }

        .sub-title {
            font-size: 11px;
            color: #666;
            margin-top: 3px;
        }

        /* INFO */
        .info {
            margin-top: 20px;
        }

        .row {
            display: table;
            width: 100%;
            padding: 6px 0;
            border-bottom: 1px solid #ddd;
        }

        .label {
            display: table-cell;
            width: 45%;
            font-weight: bold;
            color: #444;
        }

        .value {
            display: table-cell;
            width: 55%;
            text-align: right;
        }

        /* AMOUNT */
        .amount-box {
            margin: 25px 0;
            padding: 12px;
            text-align: center;
            background-color: #f8f9fa;
            border: 2px dashed #555;
        }

        .amount-label {
            font-size: 11px;
            text-transform: uppercase;
            color: #555;
        }

        .amount-value {
            font-size: 20px;
            font-weight: bold;
            margin-top: 5px;
        }

        /* STATUS BADGE */
        .status-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: bold;
            text-transform: uppercase;
        }
        .status-pending { background: #fff3cd; color: #856404; }
        .status-collected { background: #d1ecf1; color: #0c5460; }
        .status-paid { background: #cce5ff; color: #004085; }
        .status-completed { background: #d4edda; color: #155724; }

        /* DISCLAIMER */
        .disclaimer {
            margin-top: 20px;
            padding: 10px;
            font-size: 10px;
            background-color: #fff3cd;
            border: 1px solid #ffeeba;
            color: #856404;
        }

        /* FOOTER */
        .footer {
            margin-top: 25px;
            font-size: 10px;
            text-align: center;
            color: #666;
            border-top: 1px solid #ccc;
            padding-top: 6px;
        }
    </style>
</head>

<body>

    <!-- HEADER -->
    <div class="header">
        <div class="agency-name">{{ receipt.agency.businessName }}</div>
        <div class="doc-title">Premium Collection Acknowledgement</div>
        <div class="sub-title">(Issued by Insurance Agent)</div>
    </div>

    <!-- INFO -->
    <div class="info">
        <div class="row">
            <div class="label">Acknowledgement No</div>
            <div class="value">{{ receipt.receiptNumber }}</div>
        </div>

        <div class="row">
            <div class="label">Policy Number</div>
            <div class="value">{{ receipt.policy.policyNumber }}</div>
        </div>

        <div class="row">
            <div class="label">Policy Holder Name</div>
            <div class="value">
                {{ receipt.policy.client.name }}
            </div>
        </div>

        <div class="row">
            <div class="label">Plan</div>
            <div class="value">
                {{ receipt.policy.licPlan.tableNumber }} - {{ receipt.policy.licPlan.planName }}
            </div>
        </div>

        <div class="row">
            <div class="label">Base Premium</div>
            <div class="value">
                {{ (receipt.basePremium / 100)|format_currency('INR', {fraction_digit: 2}, 'en_IN') }}
            </div>
        </div>

        {% if receipt.licFineAmount and receipt.licFineAmount > 0 %}
        <div class="row">
            <div class="label">LIC Late Fine</div>
            <div class="value">
                {{ (receipt.licFineAmount / 100)|format_currency('INR', {fraction_digit: 2}, 'en_IN') }}
            </div>
        </div>
        {% endif %}

        <div class="row">
            <div class="label">Status</div>
            <div class="value">
                {% if receipt.status == 'COMPLETED' %}
                    <span class="status-badge status-completed">Completed</span>
                {% elseif receipt.status == 'COLLECTED_ONLY' %}
                    <span class="status-badge status-collected">Collected</span>
                {% elseif receipt.status == 'PAID_ONLY' %}
                    <span class="status-badge status-paid">Paid to LIC</span>
                {% else %}
                    <span class="status-badge status-pending">Pending</span>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- CLIENT COLLECTION -->
    {% if receipt.collectedDate %}
    <div class="info" style="margin-top:16px;">
        <div style="font-weight:bold;color:#444;padding:8px 0;border-bottom:2px solid #ddd;margin-bottom:4px;">
            Client Collection
        </div>

        <div class="row">
            <div class="label">Date of Collection</div>
            <div class="value">{{ receipt.collectedDate|date('d-M-Y') }}</div>
        </div>

        <div class="row">
            <div class="label">Amount Collected</div>
            <div class="value">
                {{ (receipt.collectedAmount / 100)|format_currency('INR', {fraction_digit: 2}, 'en_IN') }}
            </div>
        </div>

        {% if receipt.collectionMethod %}
        <div class="row">
            <div class="label">Collection Method</div>
            <div class="value">{{ receipt.collectionMethod }}</div>
        </div>
        {% endif %}
    </div>
    {% endif %}

    <!-- LIC PAYMENT -->
    {% if receipt.paidToLicDate %}
    <div class="info" style="margin-top:16px;">
        <div style="font-weight:bold;color:#444;padding:8px 0;border-bottom:2px solid #ddd;margin-bottom:4px;">
            LIC Payment
        </div>

        <div class="row">
            <div class="label">Date Paid to LIC</div>
            <div class="value">{{ receipt.paidToLicDate|date('d-M-Y') }}</div>
        </div>

        <div class="row">
            <div class="label">Amount Paid to LIC</div>
            <div class="value">
                {{ (receipt.paidToLicAmount / 100)|format_currency('INR', {fraction_digit: 2}, 'en_IN') }}
            </div>
        </div>

        {% if receipt.paymentChannel %}
        <div class="row">
            <div class="label">Payment Channel</div>
            <div class="value">{{ receipt.paymentChannel }}</div>
        </div>
        {% endif %}
    </div>
    {% endif %}

    <!-- PREMIUM BREAKDOWN (base + riders) -->
    {% set riders = receipt.policy.riders %}
    {% set totalRiderPremium = receipt.policy.totalRiderPremium %}

    {% if riders|length > 0 %}
    <div class="info" style="margin-top:16px;">
        <div style="font-weight:bold;color:#444;padding:8px 0;border-bottom:2px solid #ddd;margin-bottom:4px;">
            Premium Breakdown
        </div>

        <div class="row">
            <div class="label">Base Premium</div>
            <div class="value">
                {{ (receipt.policy.basicPremium / 100)|format_currency('INR', {fraction_digit: 2}, 'en_IN') }}
            </div>
        </div>

        {% for rider in riders %}
            {% if rider.active %}
            <div class="row">
                <div class="label" style="padding-left:12px;font-style:italic;">
                    ↳ {{ rider.riderTypeLabel }}
                </div>
                <div class="value">
                    + {{ (rider.riderPremium / 100)|format_currency('INR', {fraction_digit: 2}, 'en_IN') }}
                </div>
            </div>
            {% endif %}
        {% endfor %}

        <div class="row" style="border-top:1px dashed #aaa;margin-top:4px;">
            <div class="label">GST</div>
            <div class="value">
                {{ (receipt.policy.gst / 100)|format_currency('INR', {fraction_digit: 2}, 'en_IN') }}
            </div>
        </div>
    </div>
    {% endif %}

    <!-- AMOUNT BOX -->
    <div class="amount-box">
        <div class="amount-label">Amount Collected from Client</div>
        <div class="amount-value">
            {% if receipt.collectedAmount %}
                {{ (receipt.collectedAmount / 100)|format_currency('INR', {fraction_digit: 2}, 'en_IN') }}
            {% else %}
                —
            {% endif %}
        </div>
        {% if riders|length > 0 %}
        <div style="font-size:9px;color:#888;margin-top:6px;">
            Includes base premium + {{ riders|filter(r => r.active)|length }} active rider(s)
        </div>
        {% endif %}
    </div>

    <!-- DISCLAIMER -->
    <div class="disclaimer">
        <strong>Important Notice:</strong><br>
        This document is only an acknowledgement of premium amount collected by the insurance agent.
        The official and legally valid premium receipt will be issued by LIC after the premium is paid
        at LIC branch / authorised premium payment channel.
        This acknowledgement should not be treated as an LIC premium receipt.
    </div>

    <!-- FOOTER -->
    <div class="footer">
        <p>Agent Contact: {{ receipt.agency.mobile }}</p>
        <p>This is a computer-generated acknowledgement and does not require a signature.</p>
    </div>

</body>
</html>
