{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    <div style="display:flex;align-items:center;gap:14px;">
        <div class="qw-logo-icon"><i class="fas fa-bolt"></i></div>
        <div>
            <h2 class="qw-page-title mb-0">Quick Policy Entry</h2>
        </div>
    </div>
{% endblock %}

{% block main %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/css/intlTelInput.css">
<link rel="stylesheet" href="/assets/css/admin/intl_mobile_input.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.20/dist/sweetalert2.min.css">
<link rel="stylesheet" href="/assets/css/admin/sweetalert.css">
<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/js/intlTelInput.min.js"></script>
<script src="/assets/js/admin/intl_mobile_input.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.20/dist/sweetalert2.all.min.js"></script>
<script src="/assets/js/admin/sweetalert.js"></script>

<div class="qw-root">

    {# ── TOP STEPPER ── #}
    <div class="qw-stepper-bar">
        <div class="qw-stepper-track">
            <div class="qw-stepper-fill" id="stepper-fill"></div>
        </div>
        <div class="qw-steps">
            <button type="button" class="qw-step active" data-goto="1" id="step-btn-1">
                <div class="qw-step-circle"><i class="fas fa-user"></i></div>
                <div class="qw-step-label">Client</div>
            </button>
            <button type="button" class="qw-step" data-goto="2" id="step-btn-2">
                <div class="qw-step-circle"><i class="fas fa-file-shield"></i></div>
                <div class="qw-step-label">Policy</div>
            </button>
            <button type="button" class="qw-step" data-goto="3" id="step-btn-3">
                <div class="qw-step-circle"><i class="fas fa-coins"></i></div>
                <div class="qw-step-label">Premium</div>
            </button>
            <button type="button" class="qw-step" data-goto="4" id="step-btn-4">
                <div class="qw-step-circle"><i class="fas fa-user-shield"></i></div>
                <div class="qw-step-label">Nominee</div>
            </button>
            <button type="button" class="qw-step" data-goto="5" id="step-btn-5">
                <div class="qw-step-circle"><i class="fas fa-rocket"></i></div>
                <div class="qw-step-label">Submit</div>
            </button>
        </div>
    </div>

    <div class="qw-body">

        {{ form_start(form, {attr: {id: 'qw-form', novalidate: 'novalidate', autocomplete: 'off'}}) }}

        {# ── WIZARD PANELS ── #}
        <div class="qw-panels-wrap">

            {# PANEL 1: Client Details #}
            <div class="qw-panel active" id="panel-1">
                <div class="qw-panel-head">
                    <div class="qw-panel-icon bg-client"><i class="fas fa-user-circle"></i></div>
                    <div>
                        <p class="qw-panel-step-lbl">Step 1 of 5</p>
                        <h3 class="qw-panel-title">Client Details</h3>
                        <p class="qw-panel-desc">Enter the client's personal information to create their profile.</p>
                    </div>
                </div>
                <div class="qw-fields-grid">
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-user"></i>
                        {{ form_row(form.name, {
                            label: 'Name *',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-in', placeholder: 'e.g. P M Moidunni', id: 'qf_name', 'data-preview': 'pv_name'}
                        }) }}
                    </div>
                    <div class="qw-field qw-field--icon">
                        {{ form_row(form.mobile, {
                            label: 'Mobile Number *',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-in', placeholder: '+91 98765 43210', id: 'qf_mobile', 'data-preview': 'pv_mobile', 'data-intl-phone': 'true', 'data-default-country': 'in'}
                        }) }}
                    </div>
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-calendar-days"></i>
                        {{ form_row(form.dob, {
                            label: 'Date of Birth',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-in', id: 'qf_dob', 'data-preview': 'pv_dob', max: 'now'|date('Y-m-d')}
                        }) }}
                    </div>
                </div>
                <div class="qw-panel-foot">
                    <span></span>
                    <button type="button" class="qw-btn-next" onclick="qwGoto(2)">
                        Continue <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>

            {# PANEL 2: Policy Details #}
            <div class="qw-panel" id="panel-2">
                <div class="qw-panel-head">
                    <div class="qw-panel-icon bg-policy"><i class="fas fa-file-shield"></i></div>
                    <div>
                        <p class="qw-panel-step-lbl">Step 2 of 5</p>
                        <h3 class="qw-panel-title">Policy Details</h3>
                        <p class="qw-panel-desc">Select the LIC plan and set the core policy parameters.</p>
                    </div>
                </div>
                <div class="qw-fields-grid">
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-layer-group"></i>
                        {{ form_row(form.licPlan, {
                            label: 'LIC Plan *',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-sel', id: 'qf_licPlan', 'data-preview': 'pv_plan'}
                        }) }}
                        {# Limited Premium hint — shown by JS when plan has isLimitedPremium=true #}
                        <div id="qw-lp-hint" style="display:none;margin-top:8px;padding:9px 13px;background:#fff8e1;border:1.5px solid #fbbf24;border-radius:10px;font-size:12px;font-weight:600;color:#92400e;">
                            <i class="fas fa-info-circle" style="margin-right:6px;color:#f59e0b;"></i>
                            <strong>Limited Premium Plan</strong> — PPT must be less than Policy Term.
                        </div>
                    </div>
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-hashtag"></i>
                        {{ form_row(form.policyNumber, {
                            label: 'Policy Number *',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-in', placeholder: 'e.g. 801234567', id: 'qf_policyNumber', 'data-preview': 'pv_policyno'}
                        }) }}
                    </div>
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-calendar-check"></i>
                        {{ form_row(form.commencementDate, {
                            label: 'Commencement Date (DOC) *',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-in', id: 'qf_commencementDate', 'data-preview': 'pv_doc'}
                        }) }}
                    </div>
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-indian-rupee-sign"></i>
                        {{ form_row(form.sumAssured, {
                            label: 'Sum Assured (₹) *',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-in', placeholder: 'e.g. 500000', id: 'qf_sumAssured', 'data-preview': 'pv_sa'}
                        }) }}
                    </div>
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-building-columns"></i>
                        {{ form_row(form.licBranch, {
                            label: 'LIC Branch',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-in', placeholder: 'e.g. Kottayam', id: 'qf_licBranch', 'data-preview': 'pv_branch'}
                        }) }}
                    </div>
                    <div class="qw-field">
                        <div class="qw-fg">
                            <label class="qw-entry-age-label"><i class="fas fa-birthday-cake" style="margin-right:5px;color:#6366f1;"></i> Entry Age (auto)</label>
                            <div class="qw-entry-age-badge" id="qw-entry-age">-</div>
                            <div class="qw-entry-age-hint">Calculated from DOB &amp; DOC</div>
                        </div>
                    </div>
                </div>
                <div class="qw-panel-foot">
                    <button type="button" class="qw-btn-back" onclick="qwGoto(1)">
                        <i class="fas fa-arrow-left"></i> Back
                    </button>
                    <button type="button" class="qw-btn-next" onclick="qwGoto(3)">
                        Continue <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>

            {# PANEL 3: Premium Settings #}
            <div class="qw-panel" id="panel-3">
                <div class="qw-panel-head">
                    <div class="qw-panel-icon bg-premium"><i class="fas fa-coins"></i></div>
                    <div>
                        <p class="qw-panel-step-lbl">Step 3 of 5</p>
                        <h3 class="qw-panel-title">Premium Settings</h3>
                        <p class="qw-panel-desc">Define the policy term, payment schedule and premium amount.</p>
                    </div>
                </div>
                <div class="qw-fields-grid">
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-clock-rotate-left"></i>
                        {{ form_row(form.policyTerm, {
                            label: 'Policy Term (Years) *',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-in', placeholder: 'e.g. 20', id: 'qf_policyTerm', 'data-preview': 'pv_term'}
                        }) }}
                    </div>
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-hourglass-half"></i>
                        {{ form_row(form.premiumPayingTerm, {
                            label: 'Premium Paying Term (Yrs) *',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-in', placeholder: 'e.g. 15', id: 'qf_premiumPayingTerm', 'data-preview': 'pv_ppt'}
                        }) }}
                    </div>
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-repeat"></i>
                        {{ form_row(form.premiumMode, {
                            label: 'Payment Mode *',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-sel', id: 'qf_premiumMode', 'data-preview': 'pv_mode'}
                        }) }}
                        {# Mirror input: JS swaps name here when premiumMode is disabled for single-premium plans #}
                        <input type="hidden" id="qw-mode-mirror" name="" value="">
                    </div>
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-indian-rupee-sign"></i>
                        {{ form_row(form.annualPremium, {
                            label: 'Annual Premium (₹) *',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-in', placeholder: 'e.g. 25000', id: 'qf_annualPremium', 'data-preview': 'pv_annual'}
                        }) }}
                    </div>
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-wallet"></i>
                        {{ form_row(form.basicPremium, {
                            label: 'Modal Premium (₹)',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-in', placeholder: 'Auto-calculated', id: 'qf_basicPremium', 'data-preview': 'pv_premium', readonly: 'readonly'}
                        }) }}
                        <div id="qw-modal-rebate-hint" class="qw-modal-hint" style="display:none;margin-top:6px;padding:7px 12px;background:#eef2ff;border:1.5px solid #c7d2fe;border-radius:9px;font-size:11.5px;font-weight:600;color:#4338ca;">
                            <i class="fas fa-calculator" style="margin-right:5px;color:#6366f1;"></i>
                            <span id="qw-modal-formula"></span>
                        </div>
                        <div id="qw-sa-rebate-hint" class="qw-modal-hint" style="display:none;margin-top:6px;padding:7px 12px;background:#f0fdf4;border:1.5px solid #bbf7d0;border-radius:9px;font-size:11.5px;font-weight:600;color:#15803d;">
                            <i class="fas fa-gift" style="margin-right:5px;color:#22c55e;"></i>
                            SA Rebate Applied
                        </div>
                    </div>
                </div>

                <div class="qw-panel-foot">
                    <button type="button" class="qw-btn-back" onclick="qwGoto(2)">
                        <i class="fas fa-arrow-left"></i> Back
                    </button>
                    <button type="button" class="qw-btn-next" onclick="qwGoto(4)">
                        Continue <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>

            {# PANEL 4: Nominee Details (optional) #}
            <div class="qw-panel" id="panel-4">
                <div class="qw-panel-head">
                    <div class="qw-panel-icon bg-nominee"><i class="fas fa-user-shield"></i></div>
                    <div>
                        <p class="qw-panel-step-lbl">Step 4 of 5</p>
                        <h3 class="qw-panel-title">Nominee Details</h3>
                        <p class="qw-panel-desc">Add the primary nominee for this policy. These fields are optional - more nominees can be added later.</p>
                    </div>
                </div>
                <div class="qw-fields-grid">
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-user"></i>
                        {{ form_row(form.nomineeName, {
                            label: 'Nominee Name',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-in', placeholder: 'e.g. Priya George', id: 'qf_nomineeName', 'data-preview': 'pv_nomineeName'}
                        }) }}
                    </div>
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-people-arrows"></i>
                        {{ form_row(form.nomineeRelationship, {
                            label: 'Relationship',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-sel', id: 'qf_nomineeRelationship', 'data-preview': 'pv_nomineeRel'}
                        }) }}
                    </div>
                    <div class="qw-field qw-field--icon">
                        <i class="qw-ico fas fa-percent"></i>
                        {{ form_row(form.nomineeSharePercentage, {
                            label: 'Share Percentage (%)',
                            row_attr: {class: 'qw-fg'},
                            attr: {class: 'qw-in', placeholder: 'e.g. 100', id: 'qf_nomineeSharePercentage', 'data-preview': 'pv_nomineeShare'}
                        }) }}
                    </div>
                </div>
                <div class="qw-panel-foot">
                    <button type="button" class="qw-btn-back" onclick="qwGoto(3)">
                        <i class="fas fa-arrow-left"></i> Back
                    </button>
                    <button type="button" class="qw-btn-next" onclick="qwGoto(5)">
                        Review &amp; Submit <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>

            {# PANEL 5: Review & Submit #}
            <div class="qw-panel" id="panel-5">
                <div class="qw-panel-head">
                    <div class="qw-panel-icon bg-review"><i class="fas fa-rocket"></i></div>
                    <div>
                        <p class="qw-panel-step-lbl">Step 5 of 5</p>
                        <h3 class="qw-panel-title">Review &amp; Submit</h3>
                        <p class="qw-panel-desc">Verify all details before creating the client and policy record.</p>
                    </div>
                </div>

                {# Review Summary Grid #}
                <div class="qw-review-grid">
                    <div class="qw-review-section">
                        <div class="qw-review-sec-hdr">
                            <i class="fas fa-user-circle"></i> Client Details
                            <button type="button" class="qw-edit-link" onclick="qwGoto(1)">Edit</button>
                        </div>
                        <div class="qw-review-rows" id="review-client"></div>
                    </div>
                    <div class="qw-review-section">
                        <div class="qw-review-sec-hdr">
                            <i class="fas fa-file-shield"></i> Policy Details
                            <button type="button" class="qw-edit-link" onclick="qwGoto(2)">Edit</button>
                        </div>
                        <div class="qw-review-rows" id="review-policy"></div>
                    </div>
                    <div class="qw-review-section qw-review-highlight">
                        <div class="qw-review-sec-hdr">
                            <i class="fas fa-coins"></i> Premium Settings
                            <button type="button" class="qw-edit-link" onclick="qwGoto(3)">Edit</button>
                        </div>
                        <div class="qw-review-rows" id="review-premium"></div>
                    </div>
                    <div class="qw-review-section">
                        <div class="qw-review-sec-hdr">
                            <i class="fas fa-user-shield"></i> Nominee
                            <button type="button" class="qw-edit-link" onclick="qwGoto(4)">Edit</button>
                        </div>
                        <div class="qw-review-rows" id="review-nominee"></div>
                    </div>
                </div>

                {# Live Calculated Figures #}
                <div class="qw-calc-card">
                    <div class="qw-calc-hdr">
                        <span class="qw-calc-live-dot"></span>
                        <i class="fas fa-calculator"></i>
                        <span>Auto-Calculated Figures</span>
                        <span class="qw-calc-hint">Computed live from your inputs</span>
                    </div>
                    <div class="qw-calc-grid">
                        <div class="qw-calc-cell">
                            <div class="qw-calc-label"><i class="fas fa-user-clock"></i> Entry Age</div>
                            <div class="qw-calc-val" id="calc-entry-age">-</div>
                        </div>
                        <div class="qw-calc-cell">
                            <div class="qw-calc-label"><i class="fas fa-percent"></i> GST Rate</div>
                            <div class="qw-calc-val" id="calc-gst-rate">-</div>
                        </div>
                        <div class="qw-calc-cell">
                            <div class="qw-calc-label"><i class="fas fa-indian-rupee-sign"></i> GST Amount</div>
                            <div class="qw-calc-val" id="calc-gst-amt">-</div>
                        </div>
                        <div class="qw-calc-cell qw-calc-highlight">
                            <div class="qw-calc-label"><i class="fas fa-wallet"></i> Total Premium</div>
                            <div class="qw-calc-val qw-calc-big" id="calc-total">-</div>
                        </div>
                        <div class="qw-calc-cell">
                            <div class="qw-calc-label"><i class="fas fa-calendar-check"></i> Maturity Date</div>
                            <div class="qw-calc-val" id="calc-maturity">-</div>
                        </div>
                        <div class="qw-calc-cell">
                            <div class="qw-calc-label"><i class="fas fa-bell"></i> Next Due Date</div>
                            <div class="qw-calc-val" id="calc-nextdue">-</div>
                        </div>
                    </div>
                    <div class="qw-calc-regime" id="calc-regime-note"></div>
                </div>

                <div class="qw-panel-foot">
                    <button type="button" class="qw-btn-back" onclick="qwGoto(4)">
                        <i class="fas fa-arrow-left"></i> Back
                    </button>
                    <button type="submit" class="qw-btn-submit" id="qw-submit-btn">
                        <i class="fas fa-rocket"></i>
                        <span>Create Client &amp; Policy</span>
                        <div class="qw-btn-shine"></div>
                    </button>
                </div>
            </div>

        </div>{# /panels-wrap #}

        {{ form_end(form) }}

    </div>{# /body #}

</div>{# /root #}

<style>
*, *::before, *::after { box-sizing: border-box; }
.qw-root { font-family: 'Inter', sans-serif; --accent: #6366f1; --accent2: #8b5cf6; --accent3: #a855f7; --surface: #ffffff; --surface2: #f8f7ff; --border: #e8e7f6; --text: #1e1b4b; --muted: #6b7280; --radius: 18px; }

/* Page header pieces */
.qw-logo-icon { width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;color:#fff;font-size:19px;box-shadow:0 6px 20px rgba(99,102,241,.38);flex-shrink:0; }
.qw-badge-pill { display:inline-block;font-size:10px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;background:linear-gradient(90deg,#f59e0b,#fbbf24);color:#fff;border-radius:20px;padding:2px 10px;margin-bottom:3px; }
.qw-page-title { font-size:1.45rem;font-weight:800;color:#1e1b4b;line-height:1.2; }

/* ── Root layout ── */
.qw-root { width:100%;padding-bottom:40px; }

/* ── Stepper Bar ── */
.qw-stepper-bar { background:#fff;border:1.5px solid var(--border);border-radius:var(--radius);padding:20px 28px;margin-bottom:20px;position:relative;overflow:hidden; }
.qw-stepper-track { position:absolute;top:50%;left:80px;right:80px;height:3px;background:#ede9fe;border-radius:2px;transform:translateY(-10px);z-index:0; }
.qw-stepper-fill { height:100%;width:0%;background:linear-gradient(90deg,#6366f1,#a855f7);border-radius:2px;transition:width .45s cubic-bezier(.4,0,.2,1); }
.qw-steps { display:flex;justify-content:space-between;position:relative;z-index:1; }
.qw-step { display:flex;flex-direction:column;align-items:center;gap:7px;background:none;border:none;cursor:pointer;padding:0;min-width:70px;transition:opacity .2s; }
.qw-step:hover { opacity:.8; }
.qw-step-circle { width:42px;height:42px;border-radius:50%;background:#ede9fe;display:flex;align-items:center;justify-content:center;font-size:16px;color:#c4b5fd;border:2.5px solid #ede9fe;transition:all .3s cubic-bezier(.4,0,.2,1); }
.qw-step-label { font-size:11px;font-weight:600;color:#9ca3af;letter-spacing:.3px;transition:color .3s; }
.qw-step.active .qw-step-circle { background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;border-color:#6366f1;box-shadow:0 4px 14px rgba(99,102,241,.42);transform:scale(1.1); }
.qw-step.active .qw-step-label { color:#6366f1;font-weight:700; }
.qw-step.done .qw-step-circle { background:linear-gradient(135deg,#10b981,#059669);color:#fff;border-color:#10b981;box-shadow:0 4px 12px rgba(16,185,129,.3); }
.qw-step.done .qw-step-label { color:#10b981; }
.qw-step.has-error .qw-step-circle { background:linear-gradient(135deg,#ef4444,#f97316);color:#fff;border-color:#ef4444;box-shadow:0 4px 12px rgba(239,68,68,.3);animation:qwPulseError 1.5s ease-in-out 2; }
.qw-step.has-error .qw-step-label { color:#ef4444; }
@keyframes qwPulseError { 0%,100%{transform:scale(1)} 50%{transform:scale(1.15)} }

/* ── Body ── */
.qw-body { display:grid;grid-template-columns:1fr;gap:20px; }

/* ── Panels ── */
.qw-panels-wrap { position:relative; }
.qw-panel { display:none;animation:qwFadeIn .35s cubic-bezier(.4,0,.2,1); }
.qw-panel.active { display:block; }
@keyframes qwFadeIn { from{opacity:0;transform:translateX(30px)} to{opacity:1;transform:translateX(0)} }
@keyframes qwFadeOut { from{opacity:1;transform:translateX(0)} to{opacity:0;transform:translateX(-30px)} }
