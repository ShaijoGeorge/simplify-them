}

    /* ─── step btn clicks ─── */
    function initStepBtns(){
        for(var i=1;i<=TOTAL;i++){
            (function(n){
                var btn=$id('step-btn-'+n);
                if(btn) btn.addEventListener('click', function(){
                    // Allow backward navigation freely, forward navigation triggers validation
                    qwGoto(n);
