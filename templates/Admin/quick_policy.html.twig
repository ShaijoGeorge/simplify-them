/* ─── REALTIME POLICY NUMBER DUPLICATION CHECK ─── */
var policyCheckTimer = null;
var policyIsDuplicate = false;

function initPolicyNumberCheck(){
    var input = $id('quick_policy_policyNumber');
    if(!input) return;

    // Create status indicator element
    var statusEl = document.createElement('div');
    statusEl.className = 'qw-policy-status';
    statusEl.id = 'policy-number-status';
    input.parentNode.appendChild(statusEl);

    function checkPolicyNumber(){
        var val = input.value.trim();
        statusEl.innerHTML = '';
        input.classList.remove('field-duplicate','field-available');

        if(!/^\d+$/.test(val) || val.length < 5){
            policyIsDuplicate = false;
            toggleSubmitBtn();
            return;
        }

        // Show checking state
        statusEl.className = 'qw-policy-status checking';
        statusEl.innerHTML = '<span class="status-icon"><i class="fas fa-spinner"></i></span> Checking availability…';

        fetch('/admin/quick-policy/check-policy', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({policyNumber: val})
        })
        .then(function(r){ return r.json(); })
        .then(function(data){
            // Only update if value hasn't changed during fetch
            if(input.value.trim() !== val) return;

            if(data.exists){
                policyIsDuplicate = true;
                statusEl.className = 'qw-policy-status duplicate';
                statusEl.innerHTML = '<span class="status-icon"><i class="fas fa-times"></i></span> This Policy Number already exists in the system.';
                input.classList.add('field-duplicate');
                input.classList.remove('field-available');
            } else {
                policyIsDuplicate = false;
                statusEl.className = 'qw-policy-status available';
                statusEl.innerHTML = '<span class="status-icon"><i class="fas fa-check"></i></span> Policy Number is available.';
                input.classList.add('field-available');
                input.classList.remove('field-duplicate');
            }
            toggleSubmitBtn();
        })
        .catch(function(){
            policyIsDuplicate = false;
            statusEl.innerHTML = '';
            statusEl.className = 'qw-policy-status';
            toggleSubmitBtn();
        });
    }

    function toggleSubmitBtn(){
        var btn = $id('qw-submit-btn');
        if(btn) btn.disabled = policyIsDuplicate;
    }

    // Debounced input handler
    input.addEventListener('input', function(){
        clearTimeout(policyCheckTimer);
        policyCheckTimer = setTimeout(checkPolicyNumber, 500);
    });

    // Immediate check on blur
    input.addEventListener('blur', function(){
        clearTimeout(policyCheckTimer);
        checkPolicyNumber();
    });
}

/* ─── MODAL PREMIUM AUTO-CALC ─── */
/**
 * Fetch SA rebate amount via AJAX.
 */
function fetchSaRebate(sumAssured, callback) {
    if (!sumAssured || sumAssured <= 0) {
        callback(0);
        return;
    }

    fetch('/admin/api/sa-rebate?sumAssured=' + sumAssured)
        .then(function(response) { return response.json(); })
        .then(function(data) {
            callback(data.rebateAmount || 0);
        })
        .catch(function() {
            callback(0);
        });
}

function calcModalPremium() {
    var annualStr = getVal('quick_policy_annualPremium').replace(/,/g, '');
    var annual    = parseFloat(annualStr);
    var modeEl    = $id('quick_policy_premiumMode');
    var mode      = modeEl ? modeEl.value : '';
    var basicEl   = $id('quick_policy_basicPremium');
    var hintEl    = $id('qw-modal-rebate-hint');
    var formulaEl = $id('qw-modal-formula');
    var saRebateHintEl = $id('qw-sa-rebate-hint');

    if (isNaN(annual) || annual <= 0 || !mode || !MODAL_FACTORS[mode]) {
        if (basicEl) basicEl.value = '';
        if (hintEl) hintEl.style.display = 'none';
        if (saRebateHintEl) saRebateHintEl.style.display = 'none';
        return;
    }

    var factor = MODAL_FACTORS[mode];
    var modalBase = Math.round(annual * factor * 100) / 100;

    // Fetch SA rebate
    var saVal = parseFloat(getVal('quick_policy_sumAssured').replace(/,/g, '')) || 0;
    fetchSaRebate(saVal, function(rebateAmount) {
        var finalModal = Math.max(0, modalBase - rebateAmount);
        if (basicEl) basicEl.value = finalModal.toFixed(2);

        // Update Modal factor hint
        if (hintEl && formulaEl) {
            if (factor < 1.0) {
                formulaEl.textContent = '= ₹' + annual.toLocaleString('en-IN') + ' × ' + factor + ' (' + (modeMap[mode]||mode) + ')';
                hintEl.style.display = '';
            } else {
                hintEl.style.display = 'none';
            }
        }

        // Update SA Rebate hint
        if (saRebateHintEl) {
            if (rebateAmount > 0) {
                saRebateHintEl.innerHTML = '<i class="fas fa-gift me-1"></i> SA Rebate: <strong>- ₹' + rebateAmount.toLocaleString('en-IN') + '</strong>';
                saRebateHintEl.style.display = 'block';
            } else {
                saRebateHintEl.style.display = 'none';
            }
        }

        // Chain to GST
        calcTotals();
    });
}

/* PREMIUM TABLE VALIDATION */
var qwPremiumCheckTimer = null;

function qwCheckPremiumTable() {
    if (qwPremiumCheckTimer) clearTimeout(qwPremiumCheckTimer);

    qwPremiumCheckTimer = setTimeout(function () {
        var planEl = $id('quick_policy_licPlan');
        var planId = planEl ? planEl.value : '';
        var c = calcAutoFields();
        var entryAge = c.entryAge;
        var policyTerm = parseInt(getVal('quick_policy_policyTerm'), 10);
        var sumAssured = parseFloat(getVal('quick_policy_sumAssured').replace(/,/g, ''));
        var annualPremium = parseFloat(getVal('quick_policy_annualPremium').replace(/,/g, ''));

        // Remove existing warning
        var oldWarn = $id('qw-premium-table-warning');
        if (oldWarn) oldWarn.parentNode.removeChild(oldWarn);

        // All five values must be present
        if (!planId || !entryAge || !policyTerm || isNaN(sumAssured) || sumAssured <= 0 || isNaN(annualPremium) || annualPremium <= 0) {
            return;
        }

        var url = '/admin/api/premium-check' +
            '?planId=' + encodeURIComponent(planId) +
            '&entryAge=' + encodeURIComponent(entryAge) +
            '&policyTerm=' + encodeURIComponent(policyTerm) +
            '&sumAssured=' + encodeURIComponent(sumAssured) +
            '&annualPremium=' + encodeURIComponent(annualPremium);

        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                // Remove again in case of rapid changes
                var old2 = $id('qw-premium-table-warning');
                if (old2) old2.parentNode.removeChild(old2);

                if (data.found && data.isWarning) {
                    var target = $id('quick_policy_annualPremium');
                    if (!target) return;
                    var wrapper = target.closest('.qw-field') || target.parentNode;

                    var warn = document.createElement('div');
                    warn.id = 'qw-premium-table-warning';
                    warn.style.cssText = 'margin-top:8px;padding:9px 13px;background:#fff8e1;border:1.5px solid #fbbf24;border-radius:10px;font-size:12px;font-weight:600;color:#92400e;';
                    warn.innerHTML =
                        '<i class="fas fa-triangle-exclamation" style="margin-right:6px;color:#f59e0b;"></i>' +
                        '<strong>Premium Deviation ' + data.deviationPercent.toFixed(1) + '%</strong> \u2014 ' +
                        'Expected annual premium per LIC table: <strong>\u20b9\u202f' +
                        data.expectedPremium.toLocaleString('en-IN') + '</strong>';

                    wrapper.insertAdjacentElement('afterend', warn);
                }
            })
            .catch(function () {
                // Silently ignore errors
            });
    }, 500);
}

/* ─── boot ─── */
document.addEventListener('DOMContentLoaded', function(){
    updateStepper();
    initModeBadges();
    initStepBtns();
    initSubmit();
    initPolicyNumberCheck();
    updateEntryAgeBadge();

    // Auto-update entry-age badge when DOB or DOC changes
    var dobInput = $id('quick_policy_dob');
    var docInput = $id('quick_policy_commencementDate');
    if (dobInput) dobInput.addEventListener('change', updateEntryAgeBadge);
    if (docInput) docInput.addEventListener('change', updateEntryAgeBadge);

    // Plan flags: fetch when plan changes and on page load (edit mode)
    var planInput = $id('quick_policy_licPlan');
    if (planInput) {
        planInput.addEventListener('change', onPlanChange);
        if (planInput.value) onPlanChange(); // pre-selected on edit
    }

    // Modal premium auto-calc: recalculate when annual premium or mode changes
    var annualInput = $id('quick_policy_annualPremium');
    var modeInput   = $id('quick_policy_premiumMode');
    if (annualInput) {
        annualInput.addEventListener('input', calcModalPremium);
        annualInput.addEventListener('input', qwCheckPremiumTable);
        annualInput.addEventListener('change', qwCheckPremiumTable);
    }
    if (modeInput)   modeInput.addEventListener('change', calcModalPremium);
    calcModalPremium(); // initial calc on page load

    // Premium table validation: also re-check when plan, DOB, DOC, term, or SA changes
    if (planInput) planInput.addEventListener('change', qwCheckPremiumTable);
    if (dobInput)  dobInput.addEventListener('change', qwCheckPremiumTable);
    if (docInput)  docInput.addEventListener('change', qwCheckPremiumTable);
    var termInput = $id('quick_policy_policyTerm');
    var saInput   = $id('quick_policy_sumAssured');
    if (termInput) { termInput.addEventListener('input', qwCheckPremiumTable); termInput.addEventListener('change', qwCheckPremiumTable); }
    if (saInput)   { saInput.addEventListener('input', qwCheckPremiumTable);   saInput.addEventListener('change', qwCheckPremiumTable); }

    // Automatically remove validation error borders and messages when user starts typing/changing
    ['input', 'change'].forEach(function(evt) {
        document.addEventListener(evt, function(e) {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') {
                clearFieldError(e.target);
            }
        });
    });
});
})();
