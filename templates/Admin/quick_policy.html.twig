</style>

<script>
(function(){
'use strict';

var TOTAL = 5;
var current = 1;

var modeMap = {YLY:'Yearly',HLY:'Half-Yearly',QLY:'Quarterly',NACH:'Monthly (NACH)',SINGLE:'Single'};
var MODAL_FACTORS = {YLY:1.0, HLY:0.51, QLY:0.26, NACH:0.0875, SINGLE:1.0};

/* Plan flags (isSinglePremium / isLimitedPremium) */
var qwPlanFlagsCache = {};
var qwPlanFlags = { isSinglePremium: false, isLimitedPremium: false, planTypeName: '' };

function fetchPlanFlags(planId, callback) {
    if (!planId) { callback({}); return; }
    if (qwPlanFlagsCache[planId]) { callback(qwPlanFlagsCache[planId]); return; }
    fetch('/admin/api/lic-plan/' + planId + '/flags', {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(r){ return r.json(); })
    .then(function(flags){ qwPlanFlagsCache[planId] = flags; callback(flags); })
    .catch(function(){ callback({}); });
}

function applyPlanFlagBehaviours() {
    var modeEl   = $id('quick_policy_premiumMode');
    var mirrorEl = $id('qw-mode-mirror');
    var lpHint   = $id('qw-lp-hint');

    if (qwPlanFlags.isSinglePremium) {
        if (modeEl) {
            modeEl.value    = 'SINGLE';
            modeEl.disabled = true;
            modeEl.style.opacity = '0.65';
            if (mirrorEl) {
                mirrorEl.name  = modeEl.name;
                mirrorEl.value = 'SINGLE';
                modeEl.name    = '';
            }
        }
        document.querySelectorAll('.qw-mode-badge').forEach(function(b){
            b.classList.toggle('active', b.getAttribute('data-mode') === 'SINGLE');
        });
    } else {
        if (modeEl) {
            modeEl.disabled      = false;
            modeEl.style.opacity = '';
            if (mirrorEl && mirrorEl.name) {
                modeEl.name    = mirrorEl.name;
                mirrorEl.name  = '';
                mirrorEl.value = '';
            }
        }
    }

    if (lpHint) lpHint.style.display = qwPlanFlags.isLimitedPremium ? '' : 'none';
}

function onPlanChange() {
    var planEl = $id('quick_policy_licPlan');
    var planId = planEl ? planEl.value : null;
    if (!planId) {
        qwPlanFlags = { isSinglePremium: false, isLimitedPremium: false, planTypeName: '' };
        applyPlanFlagBehaviours();
        return;
    }
    fetchPlanFlags(planId, function(flags) {
        qwPlanFlags = {
            isSinglePremium:  !!flags.isSinglePremium,
            isLimitedPremium: !!flags.isLimitedPremium,
            planTypeName:     flags.planTypeName || ''
        };
        applyPlanFlagBehaviours();
    });
}

/* ─── helpers ─── */
function $id(id){
    var el = document.getElementById(id);
    if (el) return el;
    // Backward compatibility: template uses qf_* ids while JS expects quick_policy_* ids.
    if (id.indexOf('quick_policy_') === 0) {
        return document.getElementById('qf_' + id.substring('quick_policy_'.length));
    }
    return null;
}
function getVal(id){ var el=$id(id); return el ? el.value.trim() : ''; }
function getSelText(id){ var el=$id(id); return (el && el.selectedIndex > 0) ? el.options[el.selectedIndex].text : ''; }
function fmtINR(s){ var n=parseFloat(String(s).replace(/,/g,'')); return isNaN(n) ? '' : '₹\u202f'+n.toLocaleString('en-IN'); }
function fmtDate(s){ if(!s) return ''; var d=new Date(s); return isNaN(d) ? s : d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}); }
    /* Validation */
    function clearFieldError(input) {
        var fg = input.closest('.qw-fg') || input.parentNode;
        var oldErrs = fg.querySelectorAll('.invalid-feedback');
        for (var i=0; i<oldErrs.length; i++) oldErrs[i].remove();
        input.classList.remove('qw-input-error');
    }

    function setFieldError(input, msg) {
        var fg = input.closest('.qw-fg') || input.parentNode;
        input.classList.add('qw-input-error');
        var err = document.createElement('div');
        err.className = 'invalid-feedback';
        err.innerText = msg;
        fg.appendChild(err);
    }

    function getFieldLabel(input) {
        var fg = input.closest('.qw-fg') || input.parentNode;
        var label = fg.querySelector('label');
        if (label) {
            var txt = label.textContent.replace(/\s*\*\s*$/, '').trim();
            return txt || 'This field';
        }
        return 'This field';
    }

    function validateStep(step) {
        var panel = $id('panel-' + step);
        if (!panel) return true;

        var inputs = panel.querySelectorAll('input, select');
        var isValid = true;
        var firstErrorField = null;

        inputs.forEach(function(input) {
            // Skip hidden inputs
            if (input.type === 'hidden') return;

            // Clear previous errors
            clearFieldError(input);

            var val = input.value.trim();
            var errorMsg = null;
            var name = input.name || '';
            var fieldLabel = getFieldLabel(input);

            // Required check
            if (input.hasAttribute('required') && (val === '' || (input.tagName === 'SELECT' && (val === '' || val === 'placeholder')))) {
                errorMsg = fieldLabel + ' is required.';
            }
            // Select with placeholder (empty first option selected)
            else if (input.tagName === 'SELECT' && input.hasAttribute('required') && input.selectedIndex === 0 && input.options[0] && input.options[0].value === '') {
                errorMsg = 'Please select ' + fieldLabel.toLowerCase().replace(/^the /, '') + '.';
            }
            // Field-specific validations when value is non-empty
            else if (val !== '') {
                if (name.indexOf('[name]') > -1 && !/^[a-zA-Z.\s]+$/.test(val)) {
                    errorMsg = 'Name must contain only letters, dots, and spaces.';
                } else if (name.indexOf('[mobile]') > -1 && !/^\+?[1-9]\d{7,14}$/.test(val)) {
                    errorMsg = 'Enter a valid international mobile number.';
                } else if (name.indexOf('[policyNumber]') > -1) {
                    if (!/^\d+$/.test(val)) {
                        errorMsg = 'Policy Number must contain only numbers.';
                    } else if (val.length < 5) {
                        errorMsg = 'Policy Number must be at least 5 characters.';
                    } else if (typeof policyIsDuplicate !== 'undefined' && policyIsDuplicate) {
                        errorMsg = 'This policy number already exists in the system.';
                    }
                } else if (name.indexOf('[sumAssured]') > -1) {
                    if (!/^\d+(\.\d+)?$/.test(val.replace(/,/g, ''))) {
                        errorMsg = 'Sum Assured must be a valid number.';
                    } else {
                        var num = parseFloat(val.replace(/,/g, ''));
                        if (num <= 0) errorMsg = 'Sum Assured must be a positive number.';
                    }
                } else if (name.indexOf('[policyTerm]') > -1) {
                    if (!/^\d+(\.\d+)?$/.test(val.replace(/,/g, ''))) {
                        errorMsg = 'Policy Term must be a valid number.';
                    } else {
                        var num = parseFloat(val.replace(/,/g, ''));
                        if (num <= 0) errorMsg = 'Policy Term must be a positive number.';
                    }
                } else if (name.indexOf('[annualPremium]') > -1) {
                    if (!/^\d+(\.\d+)?$/.test(val.replace(/,/g, ''))) {
                        errorMsg = 'Annual Premium must be a valid number.';
                    } else {
                        var num = parseFloat(val.replace(/,/g, ''));
                        if (num <= 0) errorMsg = 'Annual Premium must be a positive number.';
                    }
                } else if (name.indexOf('[premiumPayingTerm]') > -1) {
                    if (!/^\d+(\.\d+)?$/.test(val.replace(/,/g, ''))) {
                        errorMsg = 'Premium Paying Term must be a valid number.';
                    } else {
                        var num = parseFloat(val.replace(/,/g, ''));
                        if (num <= 0) errorMsg = 'Premium Paying Term must be a positive number.';
                    }
                } else if (name.indexOf('[basicPremium]') > -1) {
                    if (!/^\d+(\.\d+)?$/.test(val.replace(/,/g, ''))) {
                        errorMsg = 'Basic Premium must be a valid number.';
                    } else {
                        var num = parseFloat(val.replace(/,/g, ''));
                        if (num <= 0) errorMsg = 'Basic Premium must be a positive number.';
                    }
                } else if (name.indexOf('[dob]') > -1) {
                    var dobDate = new Date(val);
                    var today = new Date();
                    today.setHours(0,0,0,0);
                    var dobYear = dobDate.getFullYear();
                    if (isNaN(dobDate.getTime())) {
                        errorMsg = 'Please enter a valid date.';
                    } else if (dobYear < 1900 || dobYear > today.getFullYear() || String(dobYear).length > 4) {
                        errorMsg = 'Year must be between 1900 and ' + today.getFullYear() + '.';
                    } else if (dobDate >= today) {
                        errorMsg = 'Date of Birth must be in the past.';
                    }
                } else if (name.indexOf('[commencementDate]') > -1) {
                    var docDate = new Date(val);
                    if (isNaN(docDate.getTime())) {
                        errorMsg = 'Please enter a valid date.';
                    } else {
                        var docYear = docDate.getFullYear();
                        if (docYear < 1900 || String(docYear).length > 4) {
                            errorMsg = 'Year must be 4 digits and not before 1900.';
                        }
                    }
                } else if (name.indexOf('[nomineeName]') > -1 && !/^[a-zA-Z\s]*$/.test(val)) {
                    errorMsg = 'Nominee Name must contain only letters and spaces.';
                } else if (name.indexOf('[nomineeSharePercentage]') > -1) {
                    var shareNum = parseFloat(val);
                    if (isNaN(shareNum)) {
                        errorMsg = 'Share Percentage must be a valid number.';
                    } else if (shareNum < 1 || shareNum > 100) {
                        errorMsg = 'Share Percentage must be between 1 and 100.';
                    }
                }
            }

            // Apply error state if invalid
            if (errorMsg) {
                setFieldError(input, errorMsg);
                isValid = false;
                if (!firstErrorField) firstErrorField = input;
            }
        });

        // If validation failed, provide visual feedback
        if (!isValid) {
            // Shake the panel
            panel.classList.remove('shake');
            void panel.offsetWidth; // trigger reflow
            panel.classList.add('shake');
            setTimeout(function(){ panel.classList.remove('shake'); }, 600);

            // Mark stepper step as having errors
            var stepBtn = $id('step-btn-' + step);
            if (stepBtn) {
                stepBtn.classList.add('has-error');
                setTimeout(function(){ stepBtn.classList.remove('has-error'); }, 3000);
            }

            // Scroll to first error
            if (firstErrorField) {
                firstErrorField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                firstErrorField.focus();
            }

            // Show toast
            showValidationToast(step);
        }

        return isValid;
    }

    /* Validation toast notification - powered by SweetAlert2 */
    function showValidationToast(step) {
        var stepNames = {1:'Client Details',2:'Policy Details',3:'Premium Settings',4:'Nominee Details'};
        var msg = 'Please complete all required fields in ' + (stepNames[step]||'this section') + ' before proceeding.';

        if (typeof SimplifySwal !== 'undefined') {
            SimplifySwal.warning(msg);
        } else {
            // Fallback to native alert if SweetAlert2 hasn't loaded
            alert(msg);
        }
    }

    /* Navigation */
    window.qwGoto = function(n){

        // Validate all steps between current and target when moving forward
        if (n > current) {
            for (var s = current; s < n; s++) {
                if (!validateStep(s)) {
                    // If an intermediate step fails, navigate to that step instead
                    if (s !== current) {
                        doNavigate(s);
                    }
                    return;
                }
            }
        }

        doNavigate(n);
    };

    function doNavigate(n) {
        // animate out
        var cur = $id('panel-'+current);
        if(cur){ cur.style.animation=''; cur.classList.remove('active'); }
        current = n;
        var next = $id('panel-'+n);
        if(next){
            next.classList.add('active');
            next.style.animation = n > 0 ? 'qwFadeIn .35s cubic-bezier(.4,0,.2,1)' : 'none';
        }
        updateStepper();
        if(n === TOTAL) buildReview();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

function updateStepper(){
    for(var i=1; i<=TOTAL; i++){
        var btn = $id('step-btn-'+i);
        if(!btn) continue;
        btn.classList.remove('active','done');
        if(i < current) btn.classList.add('done');
        if(i === current) btn.classList.add('active');
    }
    // fill track
    var fill = $id('stepper-fill');
    if(fill){ fill.style.width = ((current-1)/(TOTAL-1)*100)+'%'; }
}

/* ─── review builder ─── */
function row(key, val, highlight){
    var cls = 'qw-rval' + (highlight ? ' is-premium' : '');
    return '<div class="qw-rrow"><span class="qw-rkey">'+key+'</span><span class="'+cls+'">'+
        (val||'<span style="color:#d1d5db">-</span>')+'</span></div>';
}

/* ─── AUTO-CALC ENGINE (mirrors Policy.php lifecycle hooks) ─── */
function calcAutoFields(){
    var basic   = parseFloat(getVal('quick_policy_basicPremium').replace(/,/g,''));
    var docStr  = getVal('quick_policy_commencementDate');   // yyyy-mm-dd
    var dobStr  = getVal('quick_policy_dob');                 // yyyy-mm-dd
    var term    = parseInt(getVal('quick_policy_policyTerm'), 10);
    var modeEl  = $id('quick_policy_premiumMode');
    var mode    = modeEl ? modeEl.value : '';

    /* ── Entry Age: years between DOB and DOC ── */
    var entryAge = null;
    var dob = dobStr ? new Date(dobStr) : null;
    var doc = docStr ? new Date(docStr) : null;
    if (dob && !isNaN(dob) && doc && !isNaN(doc)) {
        var age = doc.getFullYear() - dob.getFullYear();
        var m = doc.getMonth() - dob.getMonth();
        if (m < 0 || (m === 0 && doc.getDate() < dob.getDate())) { age--; }
        if (age >= 0) entryAge = age;
    }

    /* ── GST logic: mirrors calculateTotals() in Policy.php ──
       Pre-2014 (before service tax start): 0%
       Old regime (Jan-2014 to 21-Sep-2025):
         Single Premium (plan flag OR mode=SINGLE) → 1.25%
         Term plan                                  → 18%
         Traditional / others                       → 4.5% (year 1), 2.25% (year 2+)
       New regime (22-Sep-2025 onward): 0%
    */
    var GST_REFORM = new Date('2025-09-22');
    var SERVICE_TAX_START = new Date('2014-01-01');
    var gstRate  = 0;
    var regime   = '';
    if (doc && !isNaN(doc)) {
        if (doc < SERVICE_TAX_START) {
            gstRate = 0;
            regime  = 'Pre-2014 policy: 0% GST (service tax absorbed by LIC in legacy regime).';
        } else if (doc < GST_REFORM) {
            var isSingle = (mode === 'SINGLE') || !!(qwPlanFlags && qwPlanFlags.isSinglePremium);
            var isTerm   = !!(qwPlanFlags && qwPlanFlags.planTypeName && qwPlanFlags.planTypeName.toUpperCase().indexOf('TERM') !== -1);
            var policyYear = 1;
            var today = new Date();
            today.setHours(0, 0, 0, 0);
            policyYear = Math.max(1, (today.getFullYear() - doc.getFullYear()) + 1);
            var m = today.getMonth() - doc.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < doc.getDate())) {
                policyYear = Math.max(1, policyYear - 1);
            }
            if (isSingle) {
                gstRate = 1.25;
                regime  = '⚠\uFE0F Old regime (pre Sep-2025): 1.25% GST — Single Premium plan.';
            } else if (isTerm) {
                gstRate = 18;
                regime  = '⚠\uFE0F Old regime (pre Sep-2025): 18% GST — Term plan.';
            } else {
                gstRate = (policyYear === 1) ? 4.5 : 2.25;
                regime  = (policyYear === 1)
                    ? '⚠\uFE0F Old regime (pre Sep-2025): 4.5% GST (policy year 1).'
                    : '⚠\uFE0F Old regime (pre Sep-2025): 2.25% GST (policy year 2+).';
            }
        } else {
            gstRate = 0;
            regime  = '✅ New regime (post Sep-2025): 0% GST on individual life insurance.';
        }
    }

    var gstAmt   = (!isNaN(basic) && basic > 0) ? (basic * gstRate / 100) : NaN;
    var total    = (!isNaN(basic) && basic > 0) ? (basic + gstAmt)         : NaN;

    /* ── Maturity date: DOC + policyTerm years ── */
    var maturity = null;
    if (doc && !isNaN(doc) && !isNaN(term) && term > 0) {
        maturity = new Date(doc);
        maturity.setFullYear(maturity.getFullYear() + term);
    }

    /* ── Next Due Date: mirrors calculateDates() ── */
    var nextDue = null;
    if (doc && !isNaN(doc) && mode && mode !== 'SINGLE') {
        var intervals = { YLY:{m:12}, HLY:{m:6}, QLY:{m:3}, NACH:{m:1} };
        var iv = intervals[mode];
        if (iv) {
            var nd = new Date(doc);
            // advance once (first premium at DOC, next is DOC + interval)
            nd.setMonth(nd.getMonth() + iv.m);
            var today = new Date(); today.setHours(0,0,0,0);
            while (nd < today) { nd.setMonth(nd.getMonth() + iv.m); }
            nextDue = nd;
        }
    }

    return { entryAge:entryAge, gstRate:gstRate, gstAmt:gstAmt, total:total, maturity:maturity, nextDue:nextDue, regime:regime };
}

/* ── Real-time Entry Age badge updater ── */
function updateEntryAgeBadge() {
    var c = calcAutoFields();
    var badge = $id('qw-entry-age');
    if (!badge) return;
    if (c.entryAge !== null) {
        badge.textContent = c.entryAge + ' yrs';
        badge.classList.add('has-value');
    } else {
        badge.textContent = '\u2014';
        badge.classList.remove('has-value');
    }
}

function setCalc(id, text, big){
    var el = $id(id); if(!el) return;
    var isNa = (!text || text === '-');
    el.className = 'qw-calc-val' + (big ? ' qw-calc-big' : '') + (isNa ? ' na' : '');
    el.textContent = text || '-';
    if (!isNa) { el.classList.add('updated'); setTimeout(function(){ el.classList.remove('updated'); }, 700); }
    // -webkit-text-fill-color must be reset for non-gradient elements
    el.style.webkitTextFillColor = (big && !isNa) ? 'transparent' : '';
}

function buildReview(){
    var clientName=getVal('quick_policy_name');
    var rc = $id('review-client');
    if(rc) rc.innerHTML =
        row('Name', clientName || '-') +
        row('Mobile', getVal('quick_policy_mobile')||'-') +
        row('Date of Birth', fmtDate(getVal('quick_policy_dob'))||'-');

    var rp = $id('review-policy');
    if(rp) rp.innerHTML =
        row('LIC Plan', getSelText('quick_policy_licPlan')||'-') +
        row('Policy Number', getVal('quick_policy_policyNumber')||'-') +
        row('DOC', fmtDate(getVal('quick_policy_commencementDate'))||'-') +
        row('Sum Assured', fmtINR(getVal('quick_policy_sumAssured'))||'-') +
        row('LIC Branch', getVal('quick_policy_licBranch')||'-');

    var modeEl = $id('quick_policy_premiumMode');
    var modeVal = modeEl ? modeEl.value : '';
    var modeLbl = modeMap[modeVal] || modeVal || '-';

    var pt=getVal('quick_policy_policyTerm'), ppt=getVal('quick_policy_premiumPayingTerm');
    var rpm = $id('review-premium');
    if(rpm) rpm.innerHTML =
        row('Policy Term',     (pt  ? pt  +' yrs' : '-')) +
        row('Premium Paying',  (ppt ? ppt +' yrs' : '-')) +
        row('Payment Mode', modeLbl) +
        row('Annual Premium', fmtINR(getVal('quick_policy_annualPremium'))||'-', true) +
        row('Modal Premium', fmtINR(getVal('quick_policy_basicPremium'))||'-');

    // Nominee review section
    var relMap = {SPOUSE:'Spouse',SON:'Son',DAUGHTER:'Daughter',FATHER:'Father',MOTHER:'Mother',BROTHER:'Brother',SISTER:'Sister',OTHER:'Other'};
    var nn = getVal('quick_policy_nomineeName');
    var nrEl = $id('quick_policy_nomineeRelationship');
    var nrVal = nrEl ? nrEl.value : '';
    var nrLbl = relMap[nrVal] || nrVal || '-';
    var ns = getVal('quick_policy_nomineeSharePercentage');
    var rnom = $id('review-nominee');
    if(rnom) {
        if (nn) {
            rnom.innerHTML =
                row('Nominee Name', nn) +
                row('Relationship', nrLbl) +
                row('Share %', ns ? ns + '%' : '-');
        } else {
            rnom.innerHTML = '<div class="qw-rrow"><span class="qw-rkey" style="color:#9ca3af;font-style:italic;">No nominee added (can be added later)</span></div>';
        }
    }

    /* ── Populate live calc card ── */
    var c = calcAutoFields();
    setCalc('calc-entry-age', c.entryAge !== null ? c.entryAge + ' yrs' : '-');
    setCalc('calc-gst-rate', isNaN(c.gstRate) ? '-' : c.gstRate + '%');
    setCalc('calc-gst-amt',  isNaN(c.gstAmt)  ? '-' : fmtINR(c.gstAmt.toFixed(2)));
    setCalc('calc-total',    isNaN(c.total)    ? '-' : fmtINR(c.total.toFixed(2)), true);
    setCalc('calc-maturity', c.maturity ? fmtDate(c.maturity.toISOString().split('T')[0]) : '-');
    setCalc('calc-nextdue',  c.nextDue  ? fmtDate(c.nextDue.toISOString().split('T')[0])  : '-');
    var rn = $id('calc-regime-note');
    if(rn) rn.textContent = c.regime;
}

/* ─── mode badges ─── */
function initModeBadges(){
    var badges = document.querySelectorAll('.qw-mode-badge');
    var sel = $id('quick_policy_premiumMode');
    badges.forEach(function(b){
        b.addEventListener('click', function(){
